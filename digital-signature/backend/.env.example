DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production"
# 64+ hex chars — master key encrypting private keys at rest (AES-256-GCM)
ENCRYPTION_KEY="64-hex-chars-master-key-for-private-key-encryption-at-rest"
PORT=4001
CORS_ORIGIN="http://localhost:3100"
# Service-to-service credentials for /internal/* endpoints.
# Format: id:secret pairs, comma separated. Rotate by appending then removing.
INTERNAL_SERVICE_KEYS="stamp-engine:dev-internal-service-secret"
