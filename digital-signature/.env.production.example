# Digital Signature Service — production env template.
# Copy to .env (same directory as docker-compose.yml) and fill in.
# The stack refuses to start without SIG_JWT_SECRET, SIG_ENCRYPTION_KEY and
# INTERNAL_SERVICE_KEYS (see docker-compose.yml). NEVER leave generator defaults.

# ── Secrets (REQUIRED — compose will fail fast if missing) ──

# Org-session JWT secret (openssl rand -base64 48)
SIG_JWT_SECRET=

# AES-256-GCM master key for private keys AT REST — exactly 64 hex chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this key means existing signing keys can NEVER be decrypted. Back it up.
SIG_ENCRYPTION_KEY=

# Service-to-service allow-list consumed by x-service-key auth.
# Format: id:secret,id2:secret2 — MUST match the main backend's SIGNATURE_SERVICE_KEY.
INTERNAL_SERVICE_KEYS=stamp-engine:change-me-long-random-secret

# ── Database (defaults to the built-in sig-postgres container) ──
# To point at an external/migrated Postgres, set both:
# SIG_DATABASE_URL=postgresql://user:pass@host:5432/signatures
# SIG_DIRECT_URL=postgresql://user:pass@host:5432/signatures
SIG_DB_USER=smarttech
SIG_DB_PASSWORD=changeme
SIG_DB_NAME=signatures
# SIG_DATABASE_URL=
# SIG_DIRECT_URL=

# ── CORS / UI ──
# Comma-separated browser origins allowed to call this API.
SIG_CORS_ORIGIN=http://localhost:3100,https://portal.example.com

# URL the Part B mini-frontend uses in the browser.
SIG_NEXT_PUBLIC_API_URL=http://localhost:4001
