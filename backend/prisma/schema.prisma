generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemUser {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  phone     String?
  password  String
  createdAt DateTime @default(now())
}

model School {
  id                     String                  @id @default(uuid())
  name                   String
  registrationNumber     String?                 @unique
  phone                  String?
  email                  String?
  address                String?
  subscriptionStatus     String                  @default("trial")
  trialEndsAt            DateTime?
  createdAt              DateTime                @default(now())
  isActive               Boolean                 @default(true)
  logoUrl                String?
  website                String?
  SchoolStamp            String?
  directorSignature      String?
  logo                   String?
  motto                  String?
  primaryColor           String?
  subscriptionEndDate    DateTime?
  subscriptionStartDate  DateTime?
  subscriptionTier       String                  @default("basic")
  academicYears          AcademicYear[]
  adaptiveTestSessions   AdaptiveTestSession[]
  aiTutorSessions        AiTutorSession[]
  assessmentScores       AssessmentScore[]
  assessments            AssessmentType[]
  attendances            Attendance[]
  auditLogs              AuditLog[]
  behavioralRecords      BehavioralRecord[]
  breakPeriods           BreakPeriod[]
  calendarSyncs          CalendarSync[]
  classes                Class[]
  classSubjects          ClassSubject[]
  classrooms             Classroom[]
  communications         Communication[]
  communicationSettings  CommunicationSettings?
  communicationTemplates CommunicationTemplate[]
  competencyScores       CompetencyScore[]
  conversations          Conversation[]
  dashboardConfigs       DashboardConfig?
  enrollments            Enrollment[]
  exams                  Exam[]
  FeeCategory            FeeCategory[]
  FeePayment             FeePayment[]
  galleries              Gallery[]
  gradingSystems         GradingSystem[]
  homeworks              Homework[]
  interventions          Intervention[]
  learningAreas          LearningArea[]
  learningStyleProfiles  LearningStyleProfile[]
  lessonPlans            LessonPlan[]
  lessonRequirements     LessonRequirement[]
  levelTypes             LevelType[]
  libraries              Library[]
  NoticeBoard            NoticeBoard[]
  parents                Parent[]
  readingSessions        ReadingSession[]
  reportTemplates        ReportTemplate[]
  results                Result[]
  setting                SchoolSetting?
  schoolUsers            SchoolUser[]
  students               Student[]
  studentGrowthRecords   StudentGrowthRecord[]
  studentInterventions   StudentIntervention[]
  subjects               Subject[]
  subscription           Subscription?
  teachers               Teacher[]
  teacherAbsences        TeacherAbsence[]
  teachingAssignments    TeachingAssignment[]
  timetables             Timetable[]
  timetableConstraint    TimetableConstraint?
  users                  User[]

  @@index([isActive])
  @@index([createdAt])
}

model AcademicYear {
  id                  String               @id @default(uuid())
  name                String
  startDate           DateTime
  endDate             DateTime
  isCurrent           Boolean              @default(false)
  schoolId            String
  createdAt           DateTime             @default(now())
  school              School               @relation(fields: [schoolId], references: [id])
  enrollments         Enrollment[]
  FeeCategory         FeeCategory[]
  teachingAssignments TeachingAssignment[]
  terms               Term[]

  @@index([schoolId])
  @@index([isCurrent])
  @@index([startDate, endDate])
}

model Term {
  id                   String                @id @default(uuid())
  name                 String
  startDate            DateTime
  endDate              DateTime
  isCurrent            Boolean               @default(false)
  academicYearId       String
  resultsFinalized     Boolean               @default(false)
  resultsLocked        Boolean               @default(false)
  assessments          AssessmentType[]
  competencyScores     CompetencyScore[]
  exams                Exam[]
  results              Result[]
  publications         ResultPublication[]
  studentGrowthRecords StudentGrowthRecord[]
  academicYear         AcademicYear          @relation(fields: [academicYearId], references: [id])
  timetables           Timetable[]

  @@index([academicYearId])
  @@index([isCurrent])
}

model User {
  id                  String               @id @default(uuid())
  firstName           String
  lastName            String
  email               String               @unique
  phone               String?
  password            String
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  schoolId            String?
  studentId           String?              @unique
  auditLogs           AuditLog[]
  communications      Communication[]
  deviceTokens        DeviceToken[]
  createdExams        Exam[]
  createdHomeworks    Homework[]
  lessonPlans         LessonPlan[]
  NoticeBoard         NoticeBoard[]
  notifications       Notification[]
  readingSessions     ReadingSession[]
  results             Result[]             @relation("TeacherResults")
  schoolUsers         SchoolUser[]
  teacher             Teacher?
  teachingAssignments TeachingAssignment[]
  school              School?              @relation(fields: [schoolId], references: [id])
  student             Student?             @relation(fields: [studentId], references: [id])
  userRoles           UserRole[]

  @@index([schoolId])
  @@index([isActive])
  @@index([createdAt])
}

model Role {
  id        String     @id @default(uuid())
  name      String     @unique
  userRoles UserRole[]
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
}

model LevelType {
  id       String  @id @default(uuid())
  name     String
  schoolId String
  classes  Class[]
  school   School  @relation(fields: [schoolId], references: [id])

  @@unique([name, schoolId])
}

model Class {
  id                  String               @id @default(uuid())
  name                String
  capacity            Int?
  schoolId            String
  levelTypeId         String
  order               Int
  levelType           LevelType            @relation(fields: [levelTypeId], references: [id])
  school              School               @relation(fields: [schoolId], references: [id])
  classSubjects       ClassSubject[]
  enrollments         Enrollment[]
  exams               Exam[]
  homeworks           Homework[]
  lessonPlans         LessonPlan[]
  lessonRequirements  LessonRequirement[]
  resultPublications  ResultPublication[]
  teachingAssignments TeachingAssignment[]
  timetables          Timetable[]
}

model Subject {
  id                   String                @id @default(uuid())
  name                 String
  code                 String?
  isCore               Boolean               @default(false)
  schoolId             String
  category             String?
  credits              Int?
  description          String?
  adaptiveTestSessions AdaptiveTestSession[]
  assessments          AssessmentType[]
  classSubjects        ClassSubject[]
  exams                Exam[]
  homeworks            Homework[]
  learningAreas        LearningArea[]
  lessonPlans          LessonPlan[]
  lessonRequirements   LessonRequirement[]
  nationalBenchmarks   NationalBenchmark[]
  results              Result[]
  school               School                @relation(fields: [schoolId], references: [id])
  assignments          TeachingAssignment[]
  timetableSlots       TimetableSlot[]

  @@unique([name, schoolId])
}

model ClassSubject {
  id        String  @id @default(uuid())
  classId   String
  subjectId String
  schoolId  String
  class     Class   @relation(fields: [classId], references: [id])
  school    School  @relation(fields: [schoolId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@unique([classId, subjectId])
  @@index([classId])
  @@index([subjectId])
}

model TeachingAssignment {
  id             String       @id @default(uuid())
  teacherId      String
  classId        String
  subjectId      String
  academicYearId String
  schoolId       String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  class          Class        @relation(fields: [classId], references: [id])
  school         School       @relation(fields: [schoolId], references: [id])
  subject        Subject      @relation(fields: [subjectId], references: [id])
  teacher        User         @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, classId, subjectId, academicYearId])
}

model Teacher {
  id                 String              @id @default(uuid())
  employeeNo         String?
  hireDate           DateTime?
  userId             String              @unique
  schoolId           String
  department         String?
  gender             String?
  lessonRequirements LessonRequirement[]
  school             School              @relation(fields: [schoolId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  timetableSlots     TimetableSlot[]

  @@index([department])
}

model Student {
  id                   String                @id @default(uuid())
  admissionNumber      String
  dateOfBirth          DateTime?
  schoolId             String
  firstName            String
  lastName             String
  gender               String?
  photoUrl             String?
  adaptiveTestSessions AdaptiveTestSession[]
  aiTutorSessions      AiTutorSession[]
  assessmentScores     AssessmentScore[]
  attendances          Attendance[]
  behavioralRecords    BehavioralRecord[]
  competencyScores     CompetencyScore[]
  enrollments          Enrollment[]
  exams                ExamAttempt[]
  FeePayment           FeePayment[]
  homeworkSubmissions  HomeworkSubmission[]
  learningStyleProfile LearningStyleProfile?
  parents              ParentStudent[]
  results              Result[]
  school               School                @relation(fields: [schoolId], references: [id])
  studentGrowthRecords StudentGrowthRecord[]
  studentInterventions StudentIntervention[]
  user                 User?

  @@unique([admissionNumber, schoolId])
  @@index([schoolId])
  @@index([gender])
}

model Enrollment {
  id             String           @id @default(uuid())
  studentId      String
  academicYearId String
  classId        String
  schoolId       String
  status         EnrollmentStatus @default(ACTIVE)
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id])
  class          Class            @relation(fields: [classId], references: [id])
  school         School           @relation(fields: [schoolId], references: [id])
  student        Student          @relation(fields: [studentId], references: [id])

  @@unique([studentId, academicYearId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([classId])
  @@index([status])
}

model Result {
  id        String   @id @default(uuid())
  score     Float
  studentId String
  subjectId String
  termId    String
  teacherId String
  schoolId  String
  createdAt DateTime @default(now())
  grade     String?
  remark    String?
  school    School   @relation(fields: [schoolId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])
  subject   Subject  @relation(fields: [subjectId], references: [id])
  teacher   User     @relation("TeacherResults", fields: [teacherId], references: [id])
  term      Term     @relation(fields: [termId], references: [id])

  @@unique([studentId, subjectId, termId])
  @@index([studentId])
  @@index([subjectId])
  @@index([termId])
  @@index([schoolId])
  @@index([createdAt])
}

model GradingSystem {
  id          String       @id @default(uuid())
  name        String
  schoolId    String
  isDefault   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  gradeScales GradeScale[]
  school      School       @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, name])
}

model GradeScale {
  id              String        @id @default(uuid())
  gradingSystemId String
  minScore        Int
  maxScore        Int
  grade           String
  remark          String
  points          Int
  createdAt       DateTime      @default(now())
  gradingSystem   GradingSystem @relation(fields: [gradingSystemId], references: [id])

  @@index([gradingSystemId])
}

model ResultPublication {
  id          String    @id @default(uuid())
  termId      String
  classId     String
  schoolId    String
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  class       Class     @relation(fields: [classId], references: [id])
  term        Term      @relation(fields: [termId], references: [id])

  @@unique([classId, termId])
}

model Parent {
  id        String          @id @default(uuid())
  firstName String
  lastName  String
  phone     String?
  email     String          @unique
  password  String
  schoolId  String
  createdAt DateTime        @default(now())
  school    School          @relation(fields: [schoolId], references: [id])
  children  ParentStudent[]

  @@index([schoolId])
}

model ParentStudent {
  id        String   @id @default(uuid())
  parentId  String
  studentId String
  createdAt DateTime @default(now())
  parent    Parent   @relation(fields: [parentId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])

  @@unique([parentId, studentId])
}

model AssessmentType {
  id        String            @id @default(uuid())
  name      String
  weight    Float
  subjectId String
  termId    String
  schoolId  String
  createdAt DateTime          @default(now())
  maxScore  Float
  scores    AssessmentScore[]
  school    School            @relation(fields: [schoolId], references: [id])
  subject   Subject           @relation(fields: [subjectId], references: [id])
  term      Term              @relation(fields: [termId], references: [id])
}

model AssessmentScore {
  id               String         @id @default(uuid())
  studentId        String
  assessmentTypeId String
  score            Float
  teacherId        String
  schoolId         String
  createdAt        DateTime       @default(now())
  assessmentType   AssessmentType @relation(fields: [assessmentTypeId], references: [id])
  school           School         @relation(fields: [schoolId], references: [id])
  student          Student        @relation(fields: [studentId], references: [id])

  @@unique([studentId, assessmentTypeId])
}

model Timetable {
  id                String             @id @default(uuid())
  schoolId          String
  termId            String
  classId           String
  createdAt         DateTime           @default(now())
  breakAfterPeriod  Int?               @default(3)
  daysPerWeek       Int?               @default(5)
  name              String?
  periodDuration    Int?               @default(40)
  periodsPerDay     Int?               @default(7)
  publishedAt       DateTime?
  sessionType       String?            @default("MORNING")
  startTime         String?            @default("07:30")
  status            String             @default("DRAFT")
  class             Class              @relation(fields: [classId], references: [id])
  school            School             @relation(fields: [schoolId], references: [id])
  term              Term               @relation(fields: [termId], references: [id])
  slots             TimetableSlot[]
  timetableVersions TimetableVersion[]

  @@index([termId])
  @@index([classId])
  @@index([schoolId, termId])
  @@index([classId, termId, sessionType])
  @@index([classId, termId, status])
}

model TimetableSlot {
  id                 String              @id @default(uuid())
  timetableId        String
  day                Int
  period             Int
  subjectId          String
  teacherId          String
  classroomId        String?
  lessonSize         Int                 @default(1)
  attendances        Attendance[]
  homeworks          Homework[]
  timetableAuditLogs TimetableAuditLog[]
  classroom          Classroom?          @relation(fields: [classroomId], references: [id])
  subject            Subject             @relation(fields: [subjectId], references: [id])
  teacher            Teacher             @relation(fields: [teacherId], references: [id])
  timetable          Timetable           @relation(fields: [timetableId], references: [id], onDelete: Cascade)

  @@unique([timetableId, day, period])
  @@index([teacherId])
  @@index([subjectId])
  @@index([classroomId])
}

model LessonRequirement {
  id             String  @id @default(uuid())
  schoolId       String
  classId        String
  subjectId      String
  teacherId      String
  lessonsPerWeek Int
  lessonType     String  @default("single")
  class          Class   @relation(fields: [classId], references: [id])
  school         School  @relation(fields: [schoolId], references: [id])
  subject        Subject @relation(fields: [subjectId], references: [id])
  teacher        Teacher @relation(fields: [teacherId], references: [id])
}

model Classroom {
  id             String          @id @default(uuid())
  schoolId       String
  name           String
  capacity       Int?
  school         School          @relation(fields: [schoolId], references: [id])
  timetableSlots TimetableSlot[]
}

model BreakPeriod {
  id       String @id @default(uuid())
  schoolId String
  name     String
  day      Int
  period   Int
  school   School @relation(fields: [schoolId], references: [id])
}

model SchoolSetting {
  id               String @id @default(uuid())
  schoolId         String @unique
  startTime        String @default("07:30")
  periodDuration   Int    @default(40)
  periodsPerDay    Int    @default(7)
  daysPerWeek      Int    @default(5)
  breakAfterPeriod Int    @default(3)
  breakDuration    Int    @default(15)
  breaks           Json?
  periodDurations  Json?
  school           School @relation(fields: [schoolId], references: [id])
}

model TimetableAuditLog {
  id          String        @id @default(uuid())
  schoolId    String
  timetableId String
  slotId      String
  userId      String
  action      String
  fromDay     Int?
  fromPeriod  Int?
  toDay       Int?
  toPeriod    Int?
  createdAt   DateTime      @default(now())
  slot        TimetableSlot @relation(fields: [slotId], references: [id])

  @@index([timetableId])
}

model TimetableVersion {
  id          String    @id @default(uuid())
  timetableId String
  createdAt   DateTime  @default(now())
  snapshot    Json
  timetable   Timetable @relation(fields: [timetableId], references: [id])
}

model TimetableConstraint {
  id                         String                @id @default(uuid())
  schoolId                   String                @unique
  maxLessonsPerTeacherPerDay Int                   @default(3)
  maxSubjectPerDay           Int                   @default(2)
  allowDoublePeriods         Boolean               @default(false)
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  maxConsecutivePeriods      Int                   @default(2)
  minGapBetweenSubjects      Int                   @default(0)
  preferredTimes             PreferredTime[]
  subjectCombinations        SubjectCombination[]
  teacherAvailability        TeacherAvailability[]
  school                     School                @relation(fields: [schoolId], references: [id])
}

model TeacherAvailability {
  id           String              @id @default(uuid())
  constraintId String
  teacherId    String
  day          Int
  period       Int
  isAvailable  Boolean             @default(false)
  constraint   TimetableConstraint @relation(fields: [constraintId], references: [id], onDelete: Cascade)

  @@unique([constraintId, teacherId, day, period])
}

model SubjectCombination {
  id           String              @id @default(uuid())
  constraintId String
  subject1Id   String
  subject2Id   String
  preference   String              @default("separate")
  constraint   TimetableConstraint @relation(fields: [constraintId], references: [id], onDelete: Cascade)

  @@unique([constraintId, subject1Id, subject2Id])
}

model PreferredTime {
  id           String              @id @default(uuid())
  constraintId String
  teacherId    String?
  subjectId    String?
  classId      String?
  day          Int?
  period       Int?
  preference   String              @default("prefer")
  constraint   TimetableConstraint @relation(fields: [constraintId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([subjectId])
  @@index([classId])
}

model NoticeBoard {
  id          String    @id @default(uuid())
  title       String
  content     String
  category    String    @default("general")
  priority    String    @default("normal")
  isPublished Boolean   @default(false)
  publishAt   DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  schoolId    String
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id])
  school      School    @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([isPublished])
  @@index([category])
}

model FeePayment {
  id            String      @id @default(uuid())
  amount        Float
  paymentDate   DateTime    @default(now())
  paymentMethod String?
  referenceNo   String?
  status        String      @default("pending")
  notes         String?
  studentId     String
  feeCategoryId String
  schoolId      String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  feeCategory   FeeCategory @relation(fields: [feeCategoryId], references: [id])
  school        School      @relation(fields: [schoolId], references: [id])
  student       Student     @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([feeCategoryId])
  @@index([schoolId])
  @@index([status])
}

model FeeCategory {
  id             String        @id @default(uuid())
  name           String
  description    String?
  amount         Float
  isRecurring    Boolean       @default(false)
  dueDate        DateTime?
  academicYearId String?
  schoolId       String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  school         School        @relation(fields: [schoolId], references: [id])
  payments       FeePayment[]

  @@unique([name, schoolId])
  @@index([schoolId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  schoolId  String
  action    String
  model     String
  recordId  String
  changes   Json?
  createdAt DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([schoolId])
  @@index([model])
  @@index([createdAt])
}

model DashboardConfig {
  id               String   @id @default(uuid())
  schoolId         String   @unique
  widgets          Json     @default("[]")
  showStudentStats Boolean  @default(true)
  showTeacherStats Boolean  @default(true)
  showFeeStats     Boolean  @default(true)
  showAttendance   Boolean  @default(true)
  showNotices      Boolean  @default(true)
  showTimetable    Boolean  @default(true)
  themeColor       String   @default("#3B82F6")
  accentColor      String   @default("#10B981")
  dashboardLayout  String   @default("default")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  school           School   @relation(fields: [schoolId], references: [id])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubscriptionPlan {
  id            String         @id @default(uuid())
  name          String         @unique
  displayName   String
  description   String?
  monthlyPrice  Float
  yearlyPrice   Float
  currency      String         @default("ZMW")
  maxStudents   Int            @default(100)
  maxTeachers   Int            @default(20)
  maxClasses    Int            @default(10)
  maxStorageGB  Int            @default(5)
  features      Json           @default("[]")
  isActive      Boolean        @default(true)
  isPopular     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]

  @@index([isActive])
}

model Subscription {
  id                        String             @id @default(uuid())
  schoolId                  String             @unique
  planId                    String
  status                    SubscriptionStatus @default(TRIALING)
  tier                      SubscriptionTier   @default(BASIC)
  currentPeriodStart        DateTime
  currentPeriodEnd          DateTime
  cancelAtPeriodEnd         Boolean            @default(false)
  cancelledAt               DateTime?
  flutterwaveSubscriptionId String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  payments                  Payment[]
  plan                      SubscriptionPlan   @relation(fields: [planId], references: [id])
  school                    School             @relation(fields: [schoolId], references: [id])

  @@index([status])
  @@index([currentPeriodEnd])
}

model Payment {
  id                       String         @id @default(uuid())
  subscriptionId           String
  amount                   Float
  currency                 String         @default("ZMW")
  status                   PaymentStatus  @default(PENDING)
  paymentMethod            PaymentMethod?
  flutterwaveTransactionId String?
  flutterwavePaymentId     String?
  mobileMoneyPhone         String?
  mobileMoneyNetwork       String?
  description              String?
  metadata                 Json?
  paidAt                   DateTime?
  failedAt                 DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  subscription             Subscription   @relation(fields: [subscriptionId], references: [id])
  receipt                  Receipt?

  @@index([status])
  @@index([flutterwaveTransactionId])
}

model Receipt {
  id               String   @id @default(uuid())
  paymentId        String   @unique
  receiptNumber    String   @unique
  invoiceNumber    String?
  schoolName       String
  schoolAddress    String?
  schoolPhone      String?
  schoolEmail      String?
  customerName     String
  customerEmail    String?
  items            Json     @default("[]")
  subtotal         Float
  tax              Float    @default(0)
  total            Float
  paymentMethod    String
  paymentReference String?
  generatedAt      DateTime @default(now())
  pdfUrl           String?
  payment          Payment  @relation(fields: [paymentId], references: [id])

  @@index([receiptNumber])
  @@index([invoiceNumber])
}

model Communication {
  id                String              @id @default(uuid())
  type              CommunicationType
  status            CommunicationStatus @default(PENDING)
  subject           String?
  message           String
  recipientType     String?
  recipientIds      String[]
  scheduledAt       DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  metadata          Json?
  errorMessage      String?
  retryCount        Int                 @default(0)
  schoolId          String
  createdById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
