  @@unique([userId, deviceId])
  @@index([userId])
  @@index([deviceId])
  @@index([isActive])
  @@index([lastUsedAt])
}

model CredentialDeliveryLog {
  id               String    @id @default(uuid())
  userCredentialId String?
  userId           String
  channel          String    @default("EMAIL")
  recipient        String
  status           String    @default("PENDING")
  messageId        String?
  errorMessage     String?
  deliveredAt      DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation("CredentialDeliveries", fields: [userId], references: [id])

  @@index([userCredentialId])
  @@index([userId])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
}

// =============================================
// CURRICULUM ENGINE MODELS
// =============================================

enum EducationLevelCategory {
  ECE
  PRIMARY
  SECONDARY
  ADVANCED_SECONDARY
  VOCATIONAL
  TERTIARY
}

enum CurriculumStatus {
  DRAFT
  CURRENT
  ARCHIVED
  FUTURE
}

enum PathwayType {
  STEM
  TRADE
  GENERAL
  VOCATIONAL
  SPECIALIZED
}

enum SubjectCategory {
  CORE
  ELECTIVE
  VOCATIONAL
  STEM
  TRADE
  SPECIAL_PAPER
}

model EducationLevel {
  id                    String                 @id @default(uuid())
  name                  String
  code                  EducationLevelCategory
  description           String?
  isActive              Boolean                @default(true)
  schoolId              String?
  school                School?                @relation(fields: [schoolId], references: [id])
  stages                AcademicStage[]
  curricula             CurriculumVersion[]
  schoolEducationLevels SchoolEducationLevel[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([code, schoolId])
}

model CurriculumVersion {
  id                    String                     @id @default(uuid())
  name                  String
  code                  String
  description           String?
  status                CurriculumStatus           @default(DRAFT)
  educationLevelId      String
  educationLevel        EducationLevel             @relation(fields: [educationLevelId], references: [id])
  effectiveFrom         DateTime?
  effectiveTo           DateTime?
  isCurrent             Boolean                    @default(false)
  schoolId              String?
  school                School?                    @relation(fields: [schoolId], references: [id])
  stages                AcademicStage[]
  subjectGroups         SubjectGroup[]
  conversionRules       SubjectConversionRule[]
  divisionRules         DivisionRule[]
  performanceCategories PerformanceCategory[]
  examStructures        ExamStructure[]
  bestSubjectRules      BestSubjectSelectionRule[]
  certificationRules    CertificationRule[]
  promotionRules        PromotionRule[]
  pathwayRules          PathwayRule[]
  grade7Results         Grade7Result[]
  schoolCurricula       SchoolCurriculum[]
  schoolEducationLevels SchoolEducationLevel[]
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@unique([code, schoolId])
  @@index([educationLevelId])
  @@index([isCurrent])
}

model AcademicStage {
  id                      String             @id @default(uuid())
  name                    String
  code                    String
  sortOrder               Int
  educationLevelId        String
  educationLevel          EducationLevel     @relation(fields: [educationLevelId], references: [id])
  curriculumVersionId     String?
  curriculumVersion       CurriculumVersion? @relation(fields: [curriculumVersionId], references: [id])
  isActive                Boolean            @default(true)
  schoolId                String?
  school                  School?            @relation(fields: [schoolId], references: [id])
  examStructures          ExamStructure[]
  promotionRulesFromStage PromotionRule[]    @relation("FromStage")
  promotionRulesToStage   PromotionRule[]    @relation("ToStage")
  pathwayRulesEntryStage  PathwayRule[]      @relation("EntryStage")
  pathwayRulesExitStage   PathwayRule[]      @relation("ExitStage")
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@unique([code, curriculumVersionId, schoolId])
  @@index([educationLevelId])
  @@index([curriculumVersionId])
}

model SubjectGroup {
  id                      String                   @id @default(uuid())
  name                    String
  code                    String
  description             String?
  category                SubjectCategory          @default(CORE)
  curriculumVersionId     String?
  curriculumVersion       CurriculumVersion?       @relation(fields: [curriculumVersionId], references: [id])
  minSelection            Int                      @default(0)
  maxSelection            Int?
  schoolId                String?
  school                  School?                  @relation(fields: [schoolId], references: [id])
  subjectGroupSubjects    SubjectGroupSubject[]
  subjectCombinationRules SubjectCombinationRule[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@unique([code, curriculumVersionId, schoolId])
  @@index([curriculumVersionId])
}

model SubjectGroupSubject {
  id             String       @id @default(uuid())
  subjectGroupId String
  subjectGroup   SubjectGroup @relation(fields: [subjectGroupId], references: [id])
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id])
  isCompulsory   Boolean      @default(false)
  sortOrder      Int          @default(0)
  schoolId       String?
  school         School?      @relation(fields: [schoolId], references: [id])

  @@unique([subjectGroupId, subjectId])
  @@index([subjectGroupId])
  @@index([subjectId])
}

model SubjectCombinationRule {
  id                  String       @id @default(uuid())
  name                String
  code                String
  description         String?
  subjectGroupId      String
  subjectGroup        SubjectGroup @relation(fields: [subjectGroupId], references: [id])
  includedSubjects    String[] // JSON array of subject IDs this combination requires
  allowedAlternatives String[]     @default([]) // JSON array of alternative subject IDs
  schoolId            String?
  school              School?      @relation(fields: [schoolId], references: [id])
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([code, subjectGroupId, schoolId])
  @@index([subjectGroupId])
}

model SubjectConversionRule {
  id                   String             @id @default(uuid())
  name                 String
  subjectId            String
  subject              Subject            @relation(fields: [subjectId], references: [id])
  actualMaxScore       Float              @default(100)
  standardizedMax      Float              @default(150)
  conversionMultiplier Float?
  conversionFormula    String? // Optional custom formula string
  effectiveYear        Int?
  curriculumVersionId  String?
  curriculumVersion    CurriculumVersion? @relation(fields: [curriculumVersionId], references: [id])
  schoolId             String?
  school               School?            @relation(fields: [schoolId], references: [id])
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([subjectId, curriculumVersionId, schoolId])
  @@index([subjectId])
  @@index([curriculumVersionId])
}

model DivisionRule {
  id                  String             @id @default(uuid())
  name                String
  code                String
  division            String // Division 1, Division 2, etc.
  minScore            Float              @default(0)
  maxScore            Float              @default(150)
  description         String?
  label               String? // e.g. "Excellent", "Very Good"
  color               String? // UI display color
  curriculumVersionId String?
  curriculumVersion   CurriculumVersion? @relation(fields: [curriculumVersionId], references: [id])
  examStructureId     String?
  examStructure       ExamStructure?     @relation(fields: [examStructureId], references: [id])
  schoolId            String?
  school              School?            @relation(fields: [schoolId], references: [id])
  isActive            Boolean            @default(true)
  sortOrder           Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([code, curriculumVersionId, schoolId])
  @@index([curriculumVersionId])
  @@index([examStructureId])
}

model PerformanceCategory {
  id                  String             @id @default(uuid())
  name                String // One, Two, Three, Four, Five
  label               String // Excellent, Very Good, Good, Average, Below Average
  labelLocal          String? // Multilingual support
  minScore            Float?
  maxScore            Float?
  description         String?
  color               String?
  curriculumVersionId String?
  curriculumVersion   CurriculumVersion? @relation(fields: [curriculumVersionId], references: [id])
  schoolId            String?
  school              School?            @relation(fields: [schoolId], references: [id])
  sortOrder           Int                @default(0)
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([name, curriculumVersionId, schoolId])
  @@index([curriculumVersionId])
}

model ExamStructure {
  id                  String                     @id @default(uuid())
  name                String
  code                String
  description         String?
  academicStageId     String
  academicStage       AcademicStage              @relation(fields: [academicStageId], references: [id])
  curriculumVersionId String?
  curriculumVersion   CurriculumVersion?         @relation(fields: [curriculumVersionId], references: [id])
  totalMarks          Float?
  passMark            Float?
  duration            Int? // minutes
  components          ExamComponent[]
  divisionRules       DivisionRule[]
  bestSubjectRules    BestSubjectSelectionRule[]
  certificationRules  CertificationRule[]
  grade7Results       Grade7Result[]
  schoolId            String?
  school              School?                    @relation(fields: [schoolId], references: [id])
  isActive            Boolean                    @default(true)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@unique([code, academicStageId, schoolId])
  @@index([academicStageId])
  @@index([curriculumVersionId])
}

model ExamComponent {
  id               String        @id @default(uuid())
  name             String
  code             String
  description      String?
  examStructureId  String
  examStructure    ExamStructure @relation(fields: [examStructureId], references: [id])
  maxScore         Float
  weight           Float         @default(1)
  sortOrder        Int           @default(0)
  isGroupComponent Boolean       @default(false)
  groupId          String? // For SP1/SP2 grouping
  schoolId         String?
  school           School?       @relation(fields: [schoolId], references: [id])
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([code, examStructureId, schoolId])
  @@index([examStructureId])
}

model BestSubjectSelectionRule {
  id                    String             @id @default(uuid())
  name                  String
  code                  String
  description           String?
  count                 Int                @default(4) // Number of best subjects to select
  mustIncludeSubjectIds String[] // Compulsory subjects (English, Math)
  excludeSubjectIds     String[]           @default([]) // Subjects to exclude from selection
  priorityGroupIds      String[]           @default([]) // Priority subject group IDs
  curriculumVersionId   String?
  curriculumVersion     CurriculumVersion? @relation(fields: [curriculumVersionId], references: [id])
  examStructureId       String?
  examStructure         ExamStructure?     @relation(fields: [examStructureId], references: [id])
  schoolId              String?
  school                School?            @relation(fields: [schoolId], references: [id])
  isActive              Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@unique([code, curriculumVersionId, schoolId])
  @@index([curriculumVersionId])
  @@index([examStructureId])
}

model CertificationRule {
  id                    String             @id @default(uuid())
  name                  String
  code                  String
  description           String?
  minSubjects           Int                @default(6)
  maxFailingSubjects    Int                @default(0)
  minPassScore          Float              @default(40)
  mustIncludeSubjectIds String[] // Compulsory passing subjects
  minTotalScore         Float? // Minimum aggregate
  maxTotalScore         Float? // Maximum aggregate
  curriculumVersionId   String?
  curriculumVersion     CurriculumVersion? @relation(fields: [curriculumVersionId], references: [id])
  examStructureId       String?
  examStructure         ExamStructure?     @relation(fields: [examStructureId], references: [id])
  schoolId              String?
  school                School?            @relation(fields: [schoolId], references: [id])
  isActive              Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@unique([code, curriculumVersionId, schoolId])
  @@index([curriculumVersionId])
  @@index([examStructureId])
}

model PromotionRule {
  id                  String             @id @default(uuid())
  name                String
  code                String
  description         String?
  fromStageId         String?
  fromStage           AcademicStage?     @relation("FromStage", fields: [fromStageId], references: [id])
  toStageId           String?
  toStage             AcademicStage?     @relation("ToStage", fields: [toStageId], references: [id])
  minAverageScore     Float?             @default(40)
  maxFailingSubjects  Int?               @default(2)
  mustPassSubjectIds  String[] // Subjects that must be passed for promotion
  curriculumVersionId String?
  curriculumVersion   CurriculumVersion? @relation(fields: [curriculumVersionId], references: [id])
  schoolId            String?
  school              School?            @relation(fields: [schoolId], references: [id])
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([code, curriculumVersionId, schoolId])
  @@index([fromStageId])
  @@index([toStageId])
  @@index([curriculumVersionId])
}

model PathwayRule {
  id                  String             @id @default(uuid())
  name                String
  code                String
  description         String?
  pathwayType         PathwayType        @default(GENERAL)
  entryStageId        String?
  entryStage          AcademicStage?     @relation("EntryStage", fields: [entryStageId], references: [id])
  exitStageId         String?
  exitStage           AcademicStage?     @relation("ExitStage", fields: [exitStageId], references: [id])
  minEntryScore       Float?
  recommendedSubjects String[] // Subject IDs recommended for this pathway
  compulsorySubjects  String[] // Subject IDs required for this pathway
  curriculumVersionId String?
  curriculumVersion   CurriculumVersion? @relation(fields: [curriculumVersionId], references: [id])
  schoolId            String?
  school              School?            @relation(fields: [schoolId], references: [id])
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([code, curriculumVersionId, schoolId])
  @@index([entryStageId])
  @@index([exitStageId])
  @@index([curriculumVersionId])
}

model Grade7Result {
  id             String       @id @default(uuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  termId         String
  term           Term         @relation(fields: [termId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])

  // Converted standardized marks (50-150 scale)
  englishConverted           Float?
  mathematicsConverted       Float?
  scienceConverted           Float?
  socialStudiesConverted     Float?
  zambianLanguageConverted   Float?
  expressiveArtsConverted    Float?
  homeEconomicsConverted     Float?
  technologyStudiesConverted Float?
  ctsConverted               Float?
  sp1Converted               Float?
  sp2Converted               Float?

  // Aggregates
  bestFourTotal       Float? // English + Math + best 2 additional
  specialPapersTotal  Float? // SP1 + SP2
  finalAggregate      Float? // bestFourTotal + specialPapersTotal
  division            String? // Division 1-4 or Fail
  divisionScore       Float? // Score within division
  performanceCategory String? // One-Five

  // Ranking
  schoolRank   Int?
  districtRank Int?
  provinceRank Int?
  nationalRank Int?

  // Selection
  selectedSchoolId String?
  selectedSchool   School? @relation("SelectedSchool", fields: [selectedSchoolId], references: [id])
  selectionScore   Float?
  selectionStatus  String? // SELECTED, NOT_SELECTED, PENDING

  curriculumVersionId String?
  curriculumVersion   CurriculumVersion? @relation(fields: [curriculumVersionId], references: [id])
  examStructureId     String?
  examStructure       ExamStructure?     @relation(fields: [examStructureId], references: [id])
  metadata            Json? // Flexible additional data
  computedAt          DateTime           @default(now())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([studentId, termId])
  @@index([studentId])
  @@index([termId])
  @@index([schoolId])
  @@index([division])
  @@index([finalAggregate])
  @@index([schoolRank])
  @@index([districtRank])
  @@index([provinceRank])
  @@index([nationalRank])
  @@index([curriculumVersionId])
}

model SchoolEducationLevel {
  id                  String             @id @default(uuid())
  schoolId            String
  school              School             @relation(fields: [schoolId], references: [id])
  educationLevelId    String
  educationLevel      EducationLevel     @relation(fields: [educationLevelId], references: [id])
  curriculumVersionId String?
  curriculumVersion   CurriculumVersion? @relation(fields: [curriculumVersionId], references: [id])
  isActive            Boolean            @default(true)
  startedAt           DateTime?
  endedAt             DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([schoolId, educationLevelId])
  @@index([schoolId])
  @@index([educationLevelId])
  @@index([curriculumVersionId])
}

model SchoolCurriculum {
  id                  String            @id @default(uuid())
  schoolId            String
  school              School            @relation(fields: [schoolId], references: [id])
  curriculumVersionId String
  curriculumVersion   CurriculumVersion @relation(fields: [curriculumVersionId], references: [id])
  isActive            Boolean           @default(true)
  phasedInAt          DateTime?
  phasedOutAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([schoolId, curriculumVersionId])
  @@index([schoolId])
  @@index([curriculumVersionId])
}

// =============================================
// PREMIUM STAFF RETURNS & HR INTELLIGENCE HUB
// Fully isolated premium enterprise module
// Dynamic Educational Staff Intelligence & Reporting Infrastructure
// =============================================

model StaffHrProfile {
  id                        String    @id @default(uuid())
  staffId                   String    @unique
  schoolId                  String
  employeeNumber            String?
  province                  String?
  district                  String?
  station                   String?
  teacherName               String?
  gender                    String?
  dateOfBirth               DateTime?
  maritalStatus             String?
  nrcNumber                 String?
  tsNumber                  String?
  aesNumber                 String?
  substantivePosition       String?
  substantiveScale          String?
  actingPosition            String?
  administration            String?
  actingType                String?
  dateOfFirstAppointment    DateTime?
  dateOfPresentAppointment  DateTime?
  dateOfActingAppointment   DateTime?
  confirmed                 String?
  expectedConfirmationDate  DateTime?
  allowancesEntitled        String?
  employmentStatus          String?   @default("ACTIVE")
  employmentType            String?   @default("PERMANENT")
  contractEffectiveDate     DateTime?
  contractNormalised        String?
  contractEnd               DateTime?
  retirementDate            DateTime?
  payrollPoint              String?
  academicQualification     String?
  professionalQualification String?
  yearOfQualification       Int?
  specialization            String?
  nationality               String?
  emailAddress              String?
  phoneNumber               String?
  currentPosition           String?
  gradeLevel                String?
  step                      Int?
  taxId                     String?
  pensionNumber             String?
  bankName                  String?
  bankBranch                String?
  bankAccount               String?
  socialSecurityNumber      String?
  nextOfKin                 String?
  nextOfKinContact          String?
  nextOfKinRelationship     String?
  dynamicFields             Json?     @default("{}")
  lastSyncedAt              DateTime?
  syncStatus                String    @default("PENDING")
  syncHash                  String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  syncLogs          StaffSyncLog[]
  transfers         StaffTransfer[]
  qualifications    StaffQualification[]
  employmentRecords StaffEmploymentRecord[]
  positions         StaffPosition[]
  allowances        StaffAllowance[]
  contracts         StaffContract[]

  @@index([schoolId])
  @@index([employmentStatus])
  @@index([gradeLevel])
  @@index([district])
  @@index([province])
}

model StaffSyncLog {
  id           String         @id @default(uuid())
  profileId    String
  profile      StaffHrProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  syncType     String
  source       String
  changes      Json?
  status       String         @default("SUCCESS")
  errorMessage String?
  syncedAt     DateTime       @default(now())

  @@index([profileId])
  @@index([syncedAt])
  @@index([status])
}

model StaffEmploymentRecord {
  id         String         @id @default(uuid())
  profileId  String
  profile    StaffHrProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  schoolId   String
  schoolName String?
  position   String
  scale      String?
  startDate  DateTime
  endDate    DateTime?
  isCurrent  Boolean        @default(false)
  recordType String         @default("EMPLOYMENT")
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([profileId])
  @@index([schoolId])
}

model StaffReturnTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  schoolId    String
  returnType  String   @default("MONTHLY")
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  category    String?  @default("DISTRICT")
  config      Json?    @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  columns     StaffReturnColumn[]
  submissions StaffReturnSubmission[]

  @@index([schoolId])
  @@index([returnType])
}

model StaffReturnColumn {
  id              String              @id @default(uuid())
  templateId      String
  template        StaffReturnTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  columnName      String
  columnLabel     String
  columnOrder     Int
  dataType        String              @default("string")
  isRequired      Boolean             @default(false)
  isVisible       Boolean             @default(true)
  isEditable      Boolean             @default(true)
  width           Int?                @default(120)
  alignment       String?             @default("left")
  fontStyle       String?             @default("normal")
  backgroundColor String?
  defaultValue    String?
  options         Json?               @default("[]")
  validationRules Json?               @default("{}")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([templateId])
  @@index([columnOrder])
}

model StaffReturnSubmission {
  id           String              @id @default(uuid())
  templateId   String
  template     StaffReturnTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  schoolId     String
  period       String
  academicYear String?
  term         String?
  status       String              @default("DRAFT")
  data         Json                @default("[]")
  submittedAt  DateTime?
  approvedAt   DateTime?
  approvedBy   String?
  generatedBy  String?
  generatedAt  DateTime?
  notes        String?
  fileUrl      String?
  fileVersion  Int                 @default(1)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  logs StaffAuditLog[]

  @@index([templateId])
  @@index([schoolId])
  @@index([period])
  @@index([status])
}

model StaffTransfer {
  id             String         @id @default(uuid())
  profileId      String
  profile        StaffHrProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  transferType   String
  fromSchoolId   String
  toSchoolId     String
  fromSchoolName String?
  toSchoolName   String?
  fromDistrict   String?
  toDistrict     String?
  fromProvince   String?
  toProvince     String?
  transferDate   DateTime
  effectiveDate  DateTime
  reason         String?
  status         String         @default("PENDING")
  approvedBy     String?
  approvedAt     DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([profileId])
  @@index([fromSchoolId])
  @@index([toSchoolId])
  @@index([status])
}

model StaffQualification {
  id                String         @id @default(uuid())
  profileId         String
  profile           StaffHrProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  qualificationType String
  qualificationName String
  institution       String?
  yearObtained      Int?
  grade             String?
  documentUrl       String?
  isVerified        Boolean        @default(false)
  verifiedBy        String?
  verifiedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([profileId])
  @@index([qualificationType])
}

model StaffPosition {
  id            String         @id @default(uuid())
  profileId     String
  profile       StaffHrProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  positionTitle String
  positionType  String         @default("SUBSTANTIVE")
  scale         String?
  startDate     DateTime
  endDate       DateTime?
  isCurrent     Boolean        @default(true)
  isActing      Boolean        @default(false)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([profileId])
  @@index([isCurrent])
}

model StaffAllowance {
  id            String         @id @default(uuid())
  profileId     String
  profile       StaffHrProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  allowanceName String
  allowanceType String
  amount        Float?
  currency      String?        @default("ZMW")
  isActive      Boolean        @default(true)
  startDate     DateTime?
  endDate       DateTime?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([profileId])
}

model StaffContract {
  id           String         @id @default(uuid())
  profileId    String
  profile      StaffHrProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  contractType String
  startDate    DateTime
  endDate      DateTime?
  isPermanent  Boolean        @default(false)
  isCurrent    Boolean        @default(true)
  documentUrl  String?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([profileId])
}

model StaffAuditLog {
  id              String                 @id @default(uuid())
  submissionId    String?
  submission      StaffReturnSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  profileId       String?
  schoolId        String?
  action          String
  entityType      String
  entityId        String?
  performedBy     String?
  performedByName String?
  changes         Json?
  metadata        Json?
  ipAddress       String?
  createdAt       DateTime               @default(now())

  @@index([submissionId])
  @@index([profileId])
  @@index([schoolId])
  @@index([action])
  @@index([createdAt])
}
