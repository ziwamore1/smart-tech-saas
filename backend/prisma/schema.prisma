generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model SystemUser {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  phone     String?
  password  String
  createdAt DateTime @default(now())
}

// =============================================
// INSTITUTION TYPE ENGINE MODELS
// =============================================

enum InstitutionTypeCode {
  PRIMARY_SCHOOL
  SECONDARY_SCHOOL
  ADVANCED_SECONDARY
  COLLEGE
  UNIVERSITY
}

model InstitutionRole {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  category    String? // TEACHING, ADMIN, STUDENT, PARENT, SUPPORT
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  institutionTypes InstitutionTypeRole[]
  dashboards       InstitutionTypeDashboard[]
}

model InstitutionDashboard {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  layout      Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  institutionTypes InstitutionTypeDashboard[]
}

model InstitutionModule {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  category    String // CORE, ACADEMIC, ADMIN, REPORT, ANALYTICS, EXAM, TIMETABLE, AI
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  institutionTypes InstitutionTypeModule[]
}

model InstitutionFeature {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  institutionTypes InstitutionTypeFeature[]
}

model InstitutionType {
  id          String              @id @default(uuid())
  name        String
  code        InstitutionTypeCode @unique
  description String?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())

  schools    School[]
  modules    InstitutionTypeModule[]
  features   InstitutionTypeFeature[]
  roles      InstitutionTypeRole[]
  dashboards InstitutionTypeDashboard[]
  settings   InstitutionSetting[]
}

model InstitutionTypeModule {
  id                String            @id @default(uuid())
  institutionTypeId String
  institutionType   InstitutionType   @relation(fields: [institutionTypeId], references: [id])
  moduleId          String
  module            InstitutionModule @relation(fields: [moduleId], references: [id])
  isActive          Boolean           @default(true)
  sortOrder         Int               @default(0)

  @@unique([institutionTypeId, moduleId])
}

model InstitutionTypeFeature {
  id                String             @id @default(uuid())
  institutionTypeId String
  institutionType   InstitutionType    @relation(fields: [institutionTypeId], references: [id])
  featureId         String
  feature           InstitutionFeature @relation(fields: [featureId], references: [id])
  isEnabled         Boolean            @default(true)

  @@unique([institutionTypeId, featureId])
}

model InstitutionTypeRole {
  id                String          @id @default(uuid())
  institutionTypeId String
  institutionType   InstitutionType @relation(fields: [institutionTypeId], references: [id])
  roleId            String
  role              InstitutionRole @relation(fields: [roleId], references: [id])
  isActive          Boolean         @default(true)

  @@unique([institutionTypeId, roleId])
}

model InstitutionTypeDashboard {
  id                String               @id @default(uuid())
  institutionTypeId String
  institutionType   InstitutionType      @relation(fields: [institutionTypeId], references: [id])
  dashboardId       String
  dashboard         InstitutionDashboard @relation(fields: [dashboardId], references: [id])
  roleId            String?
  role              InstitutionRole?     @relation(fields: [roleId], references: [id])
  isDefault         Boolean              @default(false)

  @@unique([institutionTypeId, dashboardId])
}

model InstitutionSetting {
  id                String          @id @default(uuid())
  institutionTypeId String
  institutionType   InstitutionType @relation(fields: [institutionTypeId], references: [id])
  key               String
  value             Json
  isRequired        Boolean         @default(false)

  @@unique([institutionTypeId, key])
}

model School {
  id                      String                     @id @default(uuid())
  institutionTypeId       String?
  institutionType         InstitutionType?           @relation(fields: [institutionTypeId], references: [id])
  name                    String
  registrationNumber      String?                    @unique
  phone                   String?
  email                   String?
  address                 String?
  district                String?
  province                String?
  capacity                Int?
  minEntryScore           Float?
  subscriptionStatus      String                     @default("trial")
  trialEndsAt             DateTime?
  createdAt               DateTime                   @default(now())
  isActive                Boolean                    @default(true)
  logoUrl                 String?
  website                 String?
  SchoolStamp             String?
  directorSignature       String?
  logo                    String?
  motto                   String?
  primaryColor            String?
  subscriptionEndDate     DateTime?
  subscriptionStartDate   DateTime?
  subscriptionTier        String                     @default("basic")
  academicYears           AcademicYear[]
  adaptiveTestSessions    AdaptiveTestSession[]
  aiTutorSessions         AiTutorSession[]
  assessmentScores        AssessmentScore[]
  assessments             AssessmentType[]
  attendances             Attendance[]
  auditLogs               AuditLog[]
  behavioralRecords       BehavioralRecord[]
  breakPeriods            BreakPeriod[]
  calendarSyncs           CalendarSync[]
  classes                 Class[]
  classSubjects           ClassSubject[]
  classrooms              Classroom[]
  communications          Communication[]
  communicationSettings   CommunicationSettings?
  communicationTemplates  CommunicationTemplate[]
  competencyScores        CompetencyScore[]
  conversations           Conversation[]
  dashboardConfigs        DashboardConfig?
  enrollments             Enrollment[]
  exams                   Exam[]
  FeeCategory             FeeCategory[]
  FeePayment              FeePayment[]
  galleries               Gallery[]
  gradingSystems          GradingSystem[]
  homeworks               Homework[]
  interventions           Intervention[]
  learningAreas           LearningArea[]
  learningStyleProfiles   LearningStyleProfile[]
  lessonPlans             LessonPlan[]
  lessonRequirements      LessonRequirement[]
  levelTypes              LevelType[]
  libraries               Library[]
  NoticeBoard             NoticeBoard[]
  parents                 Parent[]
  readingSessions         ReadingSession[]
  reportTemplates         ReportTemplate[]
  results                 Result[]
  setting                 SchoolSetting?
  schoolUsers             SchoolUser[]
  students                Student[]
  studentGrowthRecords    StudentGrowthRecord[]
  studentInterventions    StudentIntervention[]
  subjects                Subject[]
  subscription            Subscription?
  teachers                Teacher[]
  teacherAbsences         TeacherAbsence[]
  teachingAssignments     TeachingAssignment[]
  timetables              Timetable[]
  timetableConstraint     TimetableConstraint?
  users                   User[]
  templateCategories      TemplateCategory[]
  templateAssets          TemplateAsset[]
  marketplaceEntries      TemplateMarketplace[]
  brandPresets            BrandPreset[]
  digitalSignatures       DigitalSignature[]
  collaborationSessions   CollaborationSession[]
  editorSnapshots         EditorSnapshot[]
  aiTemplateSuggestions   AITemplateSuggestion[]
  digitalStamps           DigitalStamp[]
  stampVerifications      StampVerification[]
  uploadedExams           UploadedExam[]
  questionBankCategories  QuestionBankCategory[]
  questionBankQuestions   QuestionBank[]
  examTemplates           ExamTemplate[]
  documentStamps          DocumentStamp[]
  approvalRequests        ApprovalRequest[]
  approvalWorkflows       ApprovalWorkflow[]
  documentSignatures      DocumentSignature[]
  ministryVerifications   MinistryVerification[]
  assessmentDefinitions   AssessmentDefinition[]
  assessmentBatches       AssessmentBatch[]
  gradingPolicies         GradingPolicy[]
  classGradingPolicies    ClassGradingPolicy[]
  computedResults         ComputedResult[]
  termSummaries           TermSummary[]
  assessmentAnalytics     AssessmentAnalytics[]
  remarks                 Remark[]
  longitudinalRecords     LongitudinalRecord[]
  departments             Department[]
  actingPositions         ActingPosition[]
  aiContextMemories       AiContextMemory[]
  aiRecommendations       AiRecommendation[]
  aiTopicMasteries        AiTopicMastery[]
  educationLevels         EducationLevel[]
  curricula               CurriculumVersion[]
  stages                  AcademicStage[]
  subjectGroups           SubjectGroup[]
  subjectGroupSubjects    SubjectGroupSubject[]
  subjectCombinationRules SubjectCombinationRule[]
  conversionRules         SubjectConversionRule[]
  divisionRules           DivisionRule[]
  performanceCategories   PerformanceCategory[]
  examStructures          ExamStructure[]
  examComponents          ExamComponent[]
  bestSubjectRules        BestSubjectSelectionRule[]
  certificationRules      CertificationRule[]
  promotionRules          PromotionRule[]
  pathwayRules            PathwayRule[]
  grade7Results           Grade7Result[]
  selectedGrade7Results   Grade7Result[]             @relation("SelectedSchool")
  schoolEducationLevels   SchoolEducationLevel[]
  schoolCurricula         SchoolCurriculum[]

  @@index([institutionTypeId])
  @@index([isActive])
  @@index([createdAt])
}

model AcademicYear {
  id                  String               @id @default(uuid())
  name                String
  startDate           DateTime
  endDate             DateTime
  isCurrent           Boolean              @default(false)
  schoolId            String
  createdAt           DateTime             @default(now())
  school              School               @relation(fields: [schoolId], references: [id])
  enrollments         Enrollment[]
  FeeCategory         FeeCategory[]
  teachingAssignments TeachingAssignment[]
  terms               Term[]
  grade7Results       Grade7Result[]

  @@index([schoolId])
  @@index([isCurrent])
  @@index([startDate, endDate])
}

model Term {
  id                   String                        @id @default(uuid())
  name                 String
  startDate            DateTime
  endDate              DateTime
  isCurrent            Boolean                       @default(false)
  academicYearId       String
  resultsFinalized     Boolean                       @default(false)
  resultsLocked        Boolean                       @default(false)
  assessments          AssessmentType[]
  competencyScores     CompetencyScore[]
  exams                Exam[]
  results              Result[]
  publications         ResultPublication[]
  studentGrowthRecords StudentGrowthRecord[]
  academicYear         AcademicYear                  @relation(fields: [academicYearId], references: [id])
  timetables           Timetable[]
  uploadedExams        UploadedExam[]
  assessmentConfigs    TermAssessmentConfiguration[]
  assessmentResults    StudentAssessmentResult[]
  assessmentBatches    AssessmentBatch[]
  computedResults      ComputedResult[]
  termSummaries        TermSummary[]
  classGradingPolicies ClassGradingPolicy[]
  longitudinalRecords  LongitudinalRecord[]
  grade7Results        Grade7Result[]

  @@index([academicYearId])
  @@index([isCurrent])
}

model User {
  id                   String                  @id @default(uuid())
  firstName            String
  lastName             String
  email                String                  @unique
  phone                String?
  username             String?                 @unique
  password             String
  photoUrl             String?
  isActive             Boolean                 @default(true)
  accountStatus        String                  @default("ACTIVE")
  mustChangePassword   Boolean                 @default(false)
  failedAttempts       Int                     @default(0)
  mfaEnabled           Boolean                 @default(false)
  mfaSecret            String?
  lastLogin            DateTime?
  lastPasswordChange   DateTime?
  resetToken           String?
  resetTokenExpiry     DateTime?
  lockoutUntil         DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime?               @updatedAt
  schoolId             String?
  studentId            String?                 @unique
  auditLogs            AuditLog[]
  communications       Communication[]
  deviceTokens         DeviceToken[]
  createdExams         Exam[]
  createdTemplates     ExamTemplate[]
  createdBankQuestions QuestionBank[]
  uploadedExams        UploadedExam[]
  createdHomeworks     Homework[]
  lessonPlans          LessonPlan[]
  NoticeBoard          NoticeBoard[]
  notifications        Notification[]
  readingSessions      ReadingSession[]
  results              Result[]                @relation("TeacherResults")
  schoolUsers          SchoolUser[]
  teacher              Teacher?
  teachingAssignments  TeachingAssignment[]
  school               School?                 @relation(fields: [schoolId], references: [id])
  student              Student?                @relation(fields: [studentId], references: [id])
  studentPhotos        StudentPhoto[]
  userRoles            UserRole[]
  aiTutorSessions      AiTutorSession[]
  appliedStamps        DocumentStamp[]         @relation("DocumentStampAppliedBy")
  requestedApprovals   ApprovalRequest[]       @relation("ApprovalRequestRequestedBy")
  approvedRequests     ApprovalRequest[]       @relation("ApprovalRequestApprover")
  createdWorkflows     ApprovalWorkflow[]      @relation("ApprovalWorkflowCreatedBy")
  auditTrailLogs       ApprovalAuditLog[]      @relation("ApprovalAuditLogUser")
  userCredentials      UserCredential[]        @relation("UserCredentials")
  passwordHistory      PasswordHistory[]       @relation("UserPasswordHistory")
  securityLogs         AccountSecurityLog[]    @relation("AccountSecurityLogs")
  loginSessions        LoginSession[]
  otpVerifications     OtpVerification[]
  deviceSessions       DeviceSession[]
  credentialDeliveries CredentialDeliveryLog[] @relation("CredentialDeliveries")
  generatedCredentials UserCredential[]        @relation("GeneratedByUser")
  classTeacherOf       Class[]

  @@index([schoolId])
  @@index([isActive])
  @@index([createdAt])
  @@index([username])
  @@index([accountStatus])
}

model Role {
  id        String     @id @default(uuid())
  name      String     @unique
  userRoles UserRole[]
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
}

model LevelType {
  id       String  @id @default(uuid())
  name     String
  schoolId String
  classes  Class[]
  school   School  @relation(fields: [schoolId], references: [id])

  @@unique([name, schoolId])
}

model Class {
  id                   String                        @id @default(uuid())
  name                 String
  capacity             Int?
  schoolId             String
  levelTypeId          String
  order                Int
  classTeacherId       String?
  levelType            LevelType                     @relation(fields: [levelTypeId], references: [id])
  school               School                        @relation(fields: [schoolId], references: [id])
  classTeacher         User?                         @relation(fields: [classTeacherId], references: [id])
  classSubjects        ClassSubject[]
  enrollments          Enrollment[]
  exams                Exam[]
  homeworks            Homework[]
  lessonPlans          LessonPlan[]
  lessonRequirements   LessonRequirement[]
  resultPublications   ResultPublication[]
  teachingAssignments  TeachingAssignment[]
  timetables           Timetable[]
  uploadedExams        UploadedExam[]
  actingPositions      ActingPosition[]
  assessmentConfigs    TermAssessmentConfiguration[]
  assessmentResults    StudentAssessmentResult[]
  assessmentBatches    AssessmentBatch[]
  computedResults      ComputedResult[]
  classGradingPolicies ClassGradingPolicy[]
  termSummaries        TermSummary[]
  longitudinalRecords  LongitudinalRecord[]
}

model Subject {
  id                     String                        @id @default(uuid())
  name                   String
  code                   String?
  isCore                 Boolean                       @default(false)
  schoolId               String
  category               String?
  credits                Int?
  description            String?
  adaptiveTestSessions   AdaptiveTestSession[]
  assessments            AssessmentType[]
  classSubjects          ClassSubject[]
  exams                  Exam[]
  homeworks              Homework[]
  learningAreas          LearningArea[]
  lessonPlans            LessonPlan[]
  lessonRequirements     LessonRequirement[]
  nationalBenchmarks     NationalBenchmark[]
  results                Result[]
  school                 School                        @relation(fields: [schoolId], references: [id])
  assignments            TeachingAssignment[]
  timetableSlots         TimetableSlot[]
  uploadedExams          UploadedExam[]
  questionBankCategories QuestionBankCategory[]
  questionBankQuestions  QuestionBank[]
  examTemplates          ExamTemplate[]
  assessmentConfigs      TermAssessmentConfiguration[]
  assessmentResults      StudentAssessmentResult[]
  assessmentBatches      AssessmentBatch[]
  computedResults        ComputedResult[]
  classGradingPolicies   ClassGradingPolicy[]
  remarks                Remark[]
  longitudinalRecords    LongitudinalRecord[]
  subjectGroupLinks      SubjectGroupSubject[]
  conversionRules        SubjectConversionRule[]

  @@unique([name, schoolId])
}

model ClassSubject {
  id        String  @id @default(uuid())
  classId   String
  subjectId String
  schoolId  String
  class     Class   @relation(fields: [classId], references: [id])
  school    School  @relation(fields: [schoolId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@unique([classId, subjectId])
  @@index([classId])
  @@index([subjectId])
}

model TeachingAssignment {
  id             String       @id @default(uuid())
  teacherId      String
  classId        String
  subjectId      String
  academicYearId String
  schoolId       String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  class          Class        @relation(fields: [classId], references: [id])
  school         School       @relation(fields: [schoolId], references: [id])
  subject        Subject      @relation(fields: [subjectId], references: [id])
  teacher        User         @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, classId, subjectId, academicYearId])
}

model Teacher {
  id                 String              @id @default(uuid())
  employeeNo         String?
  hireDate           DateTime?
  userId             String              @unique
  schoolId           String
  department         String?
  departmentId       String?
  gender             String?
  staffType          String?             @default("TEACHING")
  qualification      String?
  specialization     String?
  yearsOfExperience  Int?
  emergencyContact   String?
  emergencyPhone     String?
  lessonRequirements LessonRequirement[]
  school             School              @relation(fields: [schoolId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  departmentRel      Department?         @relation(fields: [departmentId], references: [id])
  actingPositions    ActingPosition[]
  timetableSlots     TimetableSlot[]

  @@index([department])
  @@index([staffType])
  @@index([departmentId])
}

model Department {
  id          String   @id @default(uuid())
  name        String
  code        String?
  category    String
  schoolId    String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school    School           @relation(fields: [schoolId], references: [id])
  teachers  Teacher[]
  positions ActingPosition[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([category])
}

model ActingPosition {
  id           String      @id @default(uuid())
  teacherId    String
  schoolId     String
  positionType String
  departmentId String?
  classId      String?
  isPrimary    Boolean     @default(true)
  isActive     Boolean     @default(true)
  startDate    DateTime    @default(now())
  endDate      DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  teacher    Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  class      Class?      @relation(fields: [classId], references: [id], onDelete: SetNull)
  school     School      @relation(fields: [schoolId], references: [id])

  @@index([teacherId])
  @@index([schoolId])
  @@index([positionType])
  @@index([departmentId])
  @@index([classId])
}

model Student {
  id                   String                    @id @default(uuid())
  admissionNumber      String
  dateOfBirth          DateTime?
  schoolId             String
  firstName            String
  lastName             String
  gender               String?
  photoUrl             String?
  adaptiveTestSessions AdaptiveTestSession[]
  aiTutorSessions      AiTutorSession[]
  assessmentScores     AssessmentScore[]
  attendances          Attendance[]
  behavioralRecords    BehavioralRecord[]
  competencyScores     CompetencyScore[]
  enrollments          Enrollment[]
  exams                ExamAttempt[]
  FeePayment           FeePayment[]
  homeworkSubmissions  HomeworkSubmission[]
  learningStyleProfile LearningStyleProfile?
  parents              ParentStudent[]
  results              Result[]
  school               School                    @relation(fields: [schoolId], references: [id])
  studentGrowthRecords StudentGrowthRecord[]
  studentInterventions StudentIntervention[]
  studentPhotos        StudentPhoto[]
  user                 User?
  assessmentResults    StudentAssessmentResult[]
  computedResults      ComputedResult[]
  termSummaries        TermSummary[]
  longitudinalRecords  LongitudinalRecord[]
  aiContextMemories    AiContextMemory[]
  aiRecommendations    AiRecommendation[]
  aiTopicMasteries     AiTopicMastery[]
  grade7Results        Grade7Result[]

  @@unique([admissionNumber, schoolId])
  @@index([schoolId])
  @@index([gender])
}

model StudentPhoto {
  id           String   @id @default(uuid())
  studentId    String
  imageUrl     String
  thumbnailUrl String?
  uploadedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])

  @@index([studentId])
  @@index([uploadedById])
}

model Enrollment {
  id             String           @id @default(uuid())
  studentId      String
  academicYearId String
  classId        String
  schoolId       String
  status         EnrollmentStatus @default(ACTIVE)
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id])
  class          Class            @relation(fields: [classId], references: [id])
  school         School           @relation(fields: [schoolId], references: [id])
  student        Student          @relation(fields: [studentId], references: [id])

  @@unique([studentId, academicYearId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([classId])
  @@index([status])
}

model Result {
  id        String   @id @default(uuid())
  score     Float
  studentId String
  subjectId String
  termId    String
  teacherId String
  schoolId  String
  createdAt DateTime @default(now())
  grade     String?
  remark    String?
  school    School   @relation(fields: [schoolId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])
  subject   Subject  @relation(fields: [subjectId], references: [id])
  teacher   User     @relation("TeacherResults", fields: [teacherId], references: [id])
  term      Term     @relation(fields: [termId], references: [id])

  @@unique([studentId, subjectId, termId])
  @@index([studentId])
  @@index([subjectId])
  @@index([termId])
  @@index([schoolId])
  @@index([createdAt])
}

model GradingSystem {
  id          String       @id @default(uuid())
  name        String
  schoolId    String
  isDefault   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  gradeScales GradeScale[]
  school      School       @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, name])
}

model GradeScale {
  id              String        @id @default(uuid())
  gradingSystemId String
  minScore        Int
  maxScore        Int
  grade           String
  remark          String
  points          Int
  createdAt       DateTime      @default(now())
  gradingSystem   GradingSystem @relation(fields: [gradingSystemId], references: [id])

  @@index([gradingSystemId])
}

model ResultPublication {
  id          String    @id @default(uuid())
  termId      String
  classId     String
  schoolId    String
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  class       Class     @relation(fields: [classId], references: [id])
  term        Term      @relation(fields: [termId], references: [id])

  @@unique([classId, termId])
}

model Parent {
  id        String          @id @default(uuid())
  firstName String
  lastName  String
  phone     String?
  email     String          @unique
  password  String
  schoolId  String
  createdAt DateTime        @default(now())
  school    School          @relation(fields: [schoolId], references: [id])
  children  ParentStudent[]

  @@index([schoolId])
}

model ParentStudent {
  id        String   @id @default(uuid())
  parentId  String
  studentId String
  createdAt DateTime @default(now())
  parent    Parent   @relation(fields: [parentId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])

  @@unique([parentId, studentId])
}

model AssessmentType {
  id        String            @id @default(uuid())
  name      String
  weight    Float
  subjectId String
  termId    String
  schoolId  String
  createdAt DateTime          @default(now())
  maxScore  Float
  scores    AssessmentScore[]
  school    School            @relation(fields: [schoolId], references: [id])
  subject   Subject           @relation(fields: [subjectId], references: [id])
  term      Term              @relation(fields: [termId], references: [id])

  // Legacy: Use AssessmentDefinition and TermAssessmentConfiguration instead
}

model AssessmentScore {
  id               String         @id @default(uuid())
  studentId        String
  assessmentTypeId String
  score            Float
  teacherId        String
  schoolId         String
  createdAt        DateTime       @default(now())
  assessmentType   AssessmentType @relation(fields: [assessmentTypeId], references: [id])
  school           School         @relation(fields: [schoolId], references: [id])
  student          Student        @relation(fields: [studentId], references: [id])

  @@unique([studentId, assessmentTypeId])
}

model Timetable {
  id                String             @id @default(uuid())
  schoolId          String
  termId            String
  classId           String
  createdAt         DateTime           @default(now())
  breakAfterPeriod  Int?               @default(3)
  daysPerWeek       Int?               @default(5)
  name              String?
  periodDuration    Int?               @default(40)
  periodsPerDay     Int?               @default(7)
  publishedAt       DateTime?
  sessionType       String?            @default("MORNING")
  startTime         String?            @default("07:30")
  status            String             @default("DRAFT")
  class             Class              @relation(fields: [classId], references: [id])
  school            School             @relation(fields: [schoolId], references: [id])
  term              Term               @relation(fields: [termId], references: [id])
