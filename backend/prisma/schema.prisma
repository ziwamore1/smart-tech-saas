  subject   Subject?      @relation(fields: [subjectId], references: [id])
  term      Term?         @relation(fields: [termId], references: [id])

  @@unique([classId, subjectId, termId, policyId])
  @@index([classId])
  @@index([policyId])
  @@index([schoolId])
}

model ComputedResult {
  id                 String               @id @default(uuid())
  studentId          String
  subjectId          String
  termId             String
  classId            String
  schoolId           String
  totalRawScore      Float?
  totalWeightedScore Float?
  finalPercentage    Float?
