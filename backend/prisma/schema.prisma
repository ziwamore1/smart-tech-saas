// ==========================================
// EDUCATIONAL RESULTS MANAGEMENT & CONTINUOUS ASSESSMENT ENGINE
// ==========================================

model AssessmentDefinition {
  id                 String                        @id @default(uuid())
  schoolId           String
  name               String
  code               String
  category           String                        @default("continuous")
  description        String?
  defaultMaxScore    Float                         @default(100)
  defaultWeight      Float                         @default(0)
  contributesToFinal Boolean                       @default(true)
  termBased          Boolean                       @default(true)
  active             Boolean                       @default(true)
  isSystemDefault    Boolean                       @default(false)
  sortOrder          Int                           @default(0)
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  school             School                        @relation(fields: [schoolId], references: [id])
  configurations     TermAssessmentConfiguration[]
  results            StudentAssessmentResult[]
  assessmentBatches  AssessmentBatch[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([category])
  @@index([active])
}

model TermAssessmentConfiguration {
  id               String               @id @default(uuid())
  classId          String
  subjectId        String
  termId           String
  assessmentDefId  String
  maxScore         Float
  weightPercentage Float
  mandatory        Boolean              @default(false)
  sequenceOrder    Int                  @default(0)
  allowHalfMarks   Boolean              @default(true)
  allowNegative    Boolean              @default(false)
  decimalPlaces    Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  assessmentDef    AssessmentDefinition @relation(fields: [assessmentDefId], references: [id])
  class            Class                @relation(fields: [classId], references: [id])
  subject          Subject              @relation(fields: [subjectId], references: [id])
  term             Term                 @relation(fields: [termId], references: [id])

  @@unique([classId, subjectId, termId, assessmentDefId])
  @@index([classId])
  @@index([subjectId])
  @@index([termId])
  @@index([assessmentDefId])
}

model StudentAssessmentResult {
  id              String                 @id @default(uuid())
  studentId       String
  subjectId       String
  termId          String
  classId         String
  assessmentDefId String
  batchId         String?
  rawScore        Float?
  maxScore        Float
  weightedScore   Float?
  percentage      Float?
  grade           String?
  remarks         String?
  enteredBy       String
  enteredAt       DateTime               @default(now())
  verifiedBy      String?
  verifiedAt      DateTime?
  status          AssessmentResultStatus @default(DRAFT)
  syncStatus      SyncStatus             @default(SYNCED)
  metadata        Json?                  @default("{}")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  assessmentDef   AssessmentDefinition   @relation(fields: [assessmentDefId], references: [id])
  batch           AssessmentBatch?       @relation(fields: [batchId], references: [id])
  class           Class                  @relation(fields: [classId], references: [id])
  student         Student                @relation(fields: [studentId], references: [id])
  subject         Subject                @relation(fields: [subjectId], references: [id])
  term            Term                   @relation(fields: [termId], references: [id])

  @@unique([studentId, subjectId, termId, assessmentDefId])
  @@index([studentId])
  @@index([subjectId])
  @@index([termId])
  @@index([classId])
  @@index([assessmentDefId])
  @@index([batchId])
  @@index([status])
  @@index([syncStatus])
}

model AssessmentBatch {
  id              String                    @id @default(uuid())
  schoolId        String
  classId         String
  subjectId       String
  termId          String
  assessmentDefId String
  title           String
  description     String?
  maxScore        Float
  totalStudents   Int                       @default(0)
  enteredCount    Int                       @default(0)
  verifiedCount   Int                       @default(0)
  status          BatchStatus               @default(IN_PROGRESS)
  createdBy       String
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  completedAt     DateTime?
  assessmentDef   AssessmentDefinition      @relation(fields: [assessmentDefId], references: [id])
  class           Class                     @relation(fields: [classId], references: [id])
  results         StudentAssessmentResult[]
  school          School                    @relation(fields: [schoolId], references: [id])
  subject         Subject                   @relation(fields: [subjectId], references: [id])
  term            Term                      @relation(fields: [termId], references: [id])

  @@index([schoolId])
  @@index([classId])
  @@index([subjectId])
  @@index([termId])
  @@index([assessmentDefId])
  @@index([status])
}

model GradingPolicy {
  id            String               @id @default(uuid())
  schoolId      String
  name          String
  code          String               @unique
  description   String?
  type          GradingPolicyType    @default(PERCENTAGE)
  isDefault     Boolean              @default(false)
  active        Boolean              @default(true)
  config        Json                 @default("{}")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  school        School               @relation(fields: [schoolId], references: [id])
