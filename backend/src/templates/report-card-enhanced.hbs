<html>
<head>
<style>
@page { size: A4; margin: 15mm 18mm 15mm 18mm; }
@page:first { margin-top: 12mm; }
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: 'Segoe UI', Arial, Helvetica, sans-serif; color: #111827; font-size: 13px; line-height: 1.4; }

/* ===== HEADER ===== */
.header { text-align: center; margin-bottom: 10px; padding-bottom: 8px; border-bottom: 3px solid {{primaryColor}}; }
.school-name { font-size: 23px; font-weight: 800; color: {{primaryColor}}; letter-spacing: 0.5px; }
.report-title { font-size: 15px; color: #111827; margin-top: 2px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; }
.term-info { font-size: 13px; color: #374151; margin-top: 3px; }
.header-text { font-size: 12px; color: #4b5563; margin-top: 4px; font-style: italic; }

/* ===== STUDENT INFO ===== */
.student-section { display: flex; gap: 12px; margin-bottom: 10px; align-items: stretch; }
.student-info-card { flex: 1; background: #f8f9fc; border: 1px solid #9ca3af; border-radius: 6px; padding: 10px; }
.student-info-card h3 { font-size: 13px; color: {{primaryColor}}; margin-bottom: 6px; border-bottom: 1px solid #9ca3af; padding-bottom: 3px; }
.info-row { display: flex; justify-content: space-between; padding: 2px 0; font-size: 12px; }
.info-label { color: #374151; font-weight: 700; }
.info-value { color: #111827; font-weight: 700; }
.photo-box { width: 70px; height: 85px; border: 2px solid {{primaryColor}}; border-radius: 6px; overflow: hidden; display: flex; align-items: center; justify-content: center; background: #f0f0f0; }
.photo-box img { width: 100%; height: 100%; object-fit: cover; }
.photo-placeholder { font-size: 28px; color: #6b7280; }

/* ===== DIVISION & PERFORMANCE BADGE ===== */
.performance-bar { display: flex; justify-content: center; gap: 10px; margin-bottom: 10px; flex-wrap: wrap; }
.badge { padding: 4px 12px; border-radius: 20px; font-weight: 800; font-size: 12px; text-align: center; }
.division-badge { background: {{#if division}}{{division.color}}{{else}}#6b7280{{/if}}20; color: {{#if division}}{{division.color}}{{else}}#6b7280{{/if}}; border: 2px solid {{#if division}}{{division.color}}{{else}}#6b7280{{/if}}; }
.category-badge { background: {{#if performanceCategory}}{{performanceCategory.color}}{{else}}#6b7280{{/if}}20; color: {{#if performanceCategory}}{{performanceCategory.color}}{{else}}#6b7280{{/if}}; border: 2px solid {{#if performanceCategory}}{{performanceCategory.color}}{{else}}#6b7280{{/if}}; }

/* ===== RESULTS TABLE ===== */
.section { margin-bottom: 10px; }
.section-title { font-size: 13px; font-weight: 800; color: {{primaryColor}}; margin-bottom: 5px; padding-bottom: 3px; border-bottom: 2px solid {{primaryColor}}; text-transform: uppercase; letter-spacing: 0.5px; }
table { width: 100%; border-collapse: collapse; }
th { background: #1f2937; color: #ffffff; padding: 5px 5px; text-align: center; font-size: 11px; font-weight: 700; border: 1px solid #111827; }
td { padding: 4px 5px; text-align: center; font-size: 11px; border: 1px solid #9ca3af; border-bottom-width: 1.5px; }
tr:nth-child(even) { background: {{secondaryColor}}; }
.subject-name { text-align: left !important; font-weight: 700; }
.perf-cat { display: inline-block; padding: 1px 5px; border-radius: 3px; font-size: 9px; font-weight: 700; }

/* ===== CHARTS ===== */
.charts-row { display: flex; gap: 10px; margin-bottom: 10px; }
.chart-card { flex: 1; background: #f8f9fc; border: 1px solid #9ca3af; border-radius: 6px; padding: 8px; }
.chart-title { font-size: 12px; font-weight: 700; color: {{primaryColor}}; margin-bottom: 6px; text-align: center; }

/* Bar Chart */
.bar-chart { display: flex; flex-direction: column; gap: 3px; }
.bar-row { display: flex; align-items: center; gap: 5px; }
.bar-label { width: 60px; font-size: 10px; font-weight: 700; text-align: right; color: #374151; flex-shrink: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.bar-track { flex: 1; height: 12px; background: #e5e7eb; border-radius: 3px; overflow: hidden; }
.bar-fill { height: 100%; border-radius: 3px; display: flex; align-items: center; justify-content: flex-end; padding-right: 3px; font-size: 9px; font-weight: 700; color: white; min-width: 16px; }
.bar-fill.excellent { background: linear-gradient(90deg, #10b981, #059669); }
.bar-fill.good { background: linear-gradient(90deg, #3b82f6, #2563eb); }
.bar-fill.average { background: linear-gradient(90deg, #f59e0b, #d97706); }
.bar-fill.below { background: linear-gradient(90deg, #ef4444, #dc2626); }
.bar-avg { position: absolute; top: 0; height: 100%; width: 2px; background: #111827; z-index: 2; }

/* Pie Chart */
.pie-container { display: flex; align-items: center; gap: 10px; justify-content: center; }
.pie-chart { width: 80px; height: 80px; border-radius: 50%; position: relative; }
.pie-center { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 36px; height: 36px; background: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 800; color: {{primaryColor}}; }
.pie-legend { display: flex; flex-direction: column; gap: 2px; }
.legend-item { display: flex; align-items: center; gap: 4px; font-size: 10px; }
.legend-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }

/* Histogram */
.histogram { display: flex; align-items: flex-end; gap: 2px; height: 60px; padding-top: 4px; }
.hist-bar { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 1px; }
.hist-fill { width: 100%; border-radius: 2px 2px 0 0; min-height: 2px; }
.hist-label { font-size: 9px; color: #374151; word-break: break-word; max-width: 45px; }
.hist-count { font-size: 9px; font-weight: 700; color: #111827; }

/* ===== MID-TERM COMPARISON ===== */
.comparison-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.comparison-card { background: #f8f9fc; border: 1px solid #9ca3af; border-radius: 6px; padding: 8px; }
.comparison-title { font-size: 12px; font-weight: 700; color: {{primaryColor}}; margin-bottom: 4px; }
.comparison-row { display: flex; justify-content: space-between; padding: 2px 0; font-size: 11px; }
.trend-up { color: #065f46; font-weight: 700; }
.trend-down { color: #b91c1c; font-weight: 700; }
.trend-same { color: #374151; font-weight: 700; }

/* ===== CLASS STATS ===== */
.stats-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 5px; margin-bottom: 6px; }
.stat-item { background: #f8f9fc; border: 1px solid #9ca3af; border-radius: 4px; padding: 5px; text-align: center; }
.stat-value { font-size: 14px; font-weight: 800; color: {{primaryColor}}; }
.stat-label { font-size: 9px; color: #374151; margin-top: 1px; font-weight: 600; }

/* ===== BEST SUBJECTS ===== */
.best-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 4px; }
.best-item { padding: 4px; border: 1px solid #9ca3af; border-radius: 4px; text-align: center; border-top: 3px solid {{primaryColor}}; }
.best-item.top { border-top-color: #d97706; background: #fef3c7; }
.best-subject { font-size: 10px; font-weight: 700; color: #111827; }
.best-score { font-size: 13px; font-weight: 800; color: {{primaryColor}}; }

/* ===== PARENT ANALYSIS ===== */
.analysis-box { background: linear-gradient(135deg, #f0f9ff, #e0f2fe); border: 1px solid #93c5fd; border-radius: 6px; padding: 8px; margin-bottom: 8px; }
.analysis-title { font-size: 12px; font-weight: 800; color: #0369a1; margin-bottom: 4px; }
.analysis-text { font-size: 11px; color: #1f2937; line-height: 1.5; }
.strength-item, .weakness-item { display: flex; align-items: flex-start; gap: 4px; padding: 1px 0; font-size: 11px; }
.strength-item::before { content: "✓"; color: #065f46; font-weight: 700; }
.weakness-item::before { content: "△"; color: #b45309; font-weight: 700; }

/* ===== COMMENTS ===== */
.comments-section { margin-bottom: 8px; }
.comment-box { padding: 6px; border: 1px solid #9ca3af; border-radius: 4px; margin-bottom: 5px; background: #fafbfc; }
.comment-label { font-size: 11px; font-weight: 700; color: {{primaryColor}}; margin-bottom: 2px; }
.comment-text { font-size: 11px; color: #111827; line-height: 1.4; }

/* ===== GRADES LEGEND ===== */
.legend-table { width: 100%; margin-top: 6px; }
.legend-table th { background: #1f2937; color: #ffffff; padding: 4px 5px; font-size: 11px; }
.legend-table td { padding: 4px 5px; font-size: 11px; text-align: center; border: 1px solid #9ca3af; }

/* ===== FOOTER ===== */
.footer { margin-top: 15px; display: flex; justify-content: space-between; align-items: flex-end; padding-top: 8px; border-top: 1px solid #9ca3af; }
.signature-section { text-align: center; }
.signature-line { margin-top: 20px; border-top: 1px solid #111827; width: 130px; margin-left: auto; margin-right: auto; }
.stamp-section { text-align: center; }
.stamp-image { max-width: 60px; max-height: 60px; }
.footer-text { margin-top: 10px; font-size: 10px; color: #4b5563; text-align: center; font-style: italic; border-top: 1px solid #9ca3af; padding-top: 5px; }

/* ===== PAGE BREAK CONTROL ===== */
.avoid-break { page-break-inside: avoid; break-inside: avoid; }
</style>
</head>

<body>

<!-- ==================== PAGE 1: RESULTS & ANALYTICS ==================== -->

<div class="header">
{{#if schoolLogo}}<div style="margin-bottom:6px"><img src="{{schoolLogo}}" height="45" style="max-width:110px"/></div>{{/if}}
<div class="school-name">{{schoolName}}</div>
<div class="report-title">{{#if reportTitle}}{{reportTitle}}{{else}}STUDENT REPORT CARD{{/if}}</div>
<div class="term-info">{{class.name}} | {{academicYear}} — {{termName}}{{#if examType}} | Exam: {{examType}}{{/if}}</div>
{{#if headerText}}<div class="header-text">{{headerText}}</div>{{/if}}
</div>

<!-- Student Info + Photo -->
<div class="student-section">
<div class="student-info-card" style="flex:3">
  <h3>Student Information</h3>
  <div class="info-row"><span class="info-label">Full Name:</span><span class="info-value">{{student.firstName}} {{student.lastName}}</span></div>
  <div class="info-row"><span class="info-label">Admission No:</span><span class="info-value">{{student.admissionNumber}}</span></div>
  <div class="info-row"><span class="info-label">Class:</span><span class="info-value">{{class.name}}</span></div>
  {{#if examType}}<div class="info-row"><span class="info-label">Exam Type:</span><span class="info-value">{{examType}}</span></div>{{/if}}
  {{#if student.gender}}<div class="info-row"><span class="info-label">Gender:</span><span class="info-value">{{student.gender}}</span></div>{{/if}}
  <div class="info-row"><span class="info-label">Subjects Taken:</span><span class="info-value">{{subjectBreakdown.length}}</span></div>
  {{#if attendance.attendanceRate}}<div class="info-row"><span class="info-label">Attendance:</span><span class="info-value">{{attendance.attendanceRate}}% ({{attendance.presentDays}}/{{attendance.totalDays}} days)</span></div>{{/if}}
</div>
{{#if student.photoUrl}}
<div class="photo-box"><img src="{{student.photoUrl}}" alt="Photo"/></div>
{{else}}
<div class="photo-box"><span class="photo-placeholder">📷</span></div>
{{/if}}
</div>

<!-- Performance Badges -->
<div class="performance-bar">
{{#if division}}
<div class="badge division-badge">Division: {{division.division}} — {{division.label}}</div>
{{/if}}
{{#if performanceCategory}}
<div class="badge category-badge">Performance: {{performanceCategory.label}}</div>
{{/if}}
{{#if termSummary.classSize}}
<div class="badge" style="background:#f0f9ff; color:#0369a1; border:2px solid #0ea5e9;">Class Position: {{#if termSummary.classRank}}{{termSummary.classRank}}{{else}}—{{/if}} / {{termSummary.classSize}}</div>
{{/if}}
{{#if termSummary.percentile}}
<div class="badge" style="background:#f0fdf4; color:#166534; border:2px solid #22c55e;">Top {{termSummary.percentile}}%</div>
{{/if}}
</div>

<!-- Overall Summary and education-level benchmark -->
<div class="section avoid-break">
<div class="section-title">Overall Performance Summary</div>
<div class="stats-grid">
{{#if termSummary.overallPercentage}}<div class="stat-item"><div class="stat-value">{{termSummary.overallPercentage}}%</div><div class="stat-label">Overall Score</div></div>{{/if}}
{{#if termSummary.overallGrade}}<div class="stat-item"><div class="stat-value">{{termSummary.overallGrade}}</div><div class="stat-label">Overall Grade</div></div>{{/if}}
{{#if termSummary.classSize}}<div class="stat-item" style="background:#eff6ff; border-color:#3b82f6"><div class="stat-value" style="color:#1d4ed8">{{#if termSummary.classRank}}{{termSummary.classRank}}{{else}}—{{/if}} / {{termSummary.classSize}}</div><div class="stat-label">Class Position</div></div>{{/if}}
{{#if isPrimarySchool}}
{{#if grade7Result.schoolRank}}<div class="stat-item" style="background:{{secondaryColor}}; border-color:{{primaryColor}}"><div class="stat-value" style="color:{{primaryColor}}">{{grade7Result.schoolRank}}</div><div class="stat-label">ECZ School Rank</div></div>{{/if}}
{{else}}
<div class="stat-item" style="background:#fefce8; border-color:#eab308"><div class="stat-value" style="color:#a16207">{{#if bestSixTotal}}{{bestSixTotal}}{{else}}{{totalPoints}}{{/if}}</div><div class="stat-label">Best 6 Points</div></div>
{{#if bestSubjectsAverage}}<div class="stat-item"><div class="stat-value">{{bestSubjectsAverage}}%</div><div class="stat-label">Best Avg</div></div>{{/if}}
{{/if}}
{{#if attendance.attendanceRate}}<div class="stat-item"><div class="stat-value">{{attendance.attendanceRate}}%</div><div class="stat-label">Attendance</div></div>{{/if}}
</div>

{{#if isPrimarySchool}}
<div style="background:linear-gradient(135deg, {{secondaryColor}}, #ffffff); border:2px solid {{primaryColor}}; border-radius:8px; padding:10px; text-align:center; margin-top:6px;">
<div style="font-size:12px; color:{{primaryColor}}; margin-bottom:5px; font-weight:800;">ECZ GRADE 7 COMPOSITE EXAMINATION & FORM 1 SELECTION</div>
{{#if isGrade7Ecz}}
<div style="display:flex;justify-content:center;gap:24px;flex-wrap:wrap;">
<div><div style="font-size:24px;font-weight:900;color:{{primaryColor}};line-height:1;">{{#if grade7Result.bestFourTotal}}{{grade7Result.bestFourTotal}}{{else}}—{{/if}}</div><div style="font-size:10px;color:#374151;margin-top:3px;">Certification Aggregate<br/>Best 4 of 600</div></div>
<div><div style="font-size:24px;font-weight:900;color:{{primaryColor}};line-height:1;">{{#if grade7Result.selectionScore}}{{grade7Result.selectionScore}}{{else}}—{{/if}}</div><div style="font-size:10px;color:#374151;margin-top:3px;">Form 1 Selection Score<br/>Best 4 + Special Papers of 900</div></div>
</div>
{{#if grade7Result.division}}<div style="margin-top:6px;font-size:11px;color:#374151;"><strong>ECZ Certification:</strong> {{grade7Result.division}} {{#if grade7Result.divisionScore}}({{grade7Result.divisionScore}}){{/if}}</div>{{/if}}
{{#if grade7Result.selectionStatus}}<div style="margin-top:3px;font-size:11px;color:#374151;"><strong>Form 1 Selection:</strong> {{grade7Result.selectionStatus}}</div>{{/if}}
{{else}}
<div style="font-size:11px;color:#374151;">Primary learning progress, attendance, and subject mastery. Grade 7 candidates are ranked for Form 1 placement using the ECZ composite examination selection score.</div>
{{/if}}
</div>
{{else}}
<!-- University Benchmark -->
<div style="background: linear-gradient(135deg, #fefce8, #fef9c3); border: 2px solid #a16207; border-radius: 8px; padding: 10px; text-align: center; margin-top: 6px;">
<div style="font-size: 12px; color: #713f12; margin-bottom: 5px; font-weight: 700;">University Benchmark — Best 6 Aggregate Points</div>
<div style="font-size: 32px; font-weight: 900; color: #a16207; line-height: 1;">{{#if bestSixTotal}}{{bestSixTotal}}{{else}}{{totalPoints}}{{/if}}</div>
<div style="font-size: 11px; color: #854d0e; margin-top: 3px;">out of 6 (best) to {{#if eligibility.maxBestSixPoints}}{{eligibility.maxBestSixPoints}}{{else}}54{{/if}} (worst)</div>
{{#if eligibility.bestSix.length}}
<div style="margin-top: 6px; font-size: 10px; color: #713f12;">
<strong>Best 6:</strong> 
{{#each eligibility.bestSix}}{{subjectName}} ({{#if (present points)}}{{points}}{{else}}—{{/if}} pts){{#unless @last}}, {{/unless}}{{/each}}
</div>
{{else if bestSubjects.length}}
<div style="margin-top: 6px; font-size: 10px; color: #713f12;">
<strong>Best {{bestSubjects.length}}:</strong> 
{{#each bestSubjects}}{{subjectName}} ({{#if (present points)}}{{points}}{{else}}—{{/if}} pts){{#unless @last}}, {{/unless}}{{/each}}
</div>
{{/if}}
<div style="margin-top: 4px; font-size: 10px; color: #92400e; font-style: italic;">Lower aggregate = stronger university admission</div>
{{#if eligibility}}
<div style="margin-top: 8px; padding-top: 6px; border-top: 1px dashed #facc15; background: #ffffff; border-radius: 6px;">
<div style="font-size: 14px; font-weight: 900; color: {{#if eligibility.universityEligible}}#047857{{else if eligibility.certificateAwarded}}#b45309{{else}}#b91c1c{{/if}};">{{#if eligibility.universityEligible}}UNIVERSITY ELIGIBLE{{else if eligibility.certificateAwarded}}{{eligibility.certificateName}} ONLY{{else}}NOT ELIGIBLE{{/if}}</div>
{{#if eligibility.details}}<div style="margin-top: 2px; font-size: 9px; color: #854d0e;">{{eligibility.details}}</div>{{/if}}
</div>
{{/if}}
</div>
{{/if}}
</div>

{{#if isAssessmentVariant}}
<div class="analysis-box avoid-break" style="border-color:{{primaryColor}};background:{{secondaryColor}};">
<div class="analysis-title" style="color:{{primaryColor}}">Assessment Components & Learning Outcomes</div>
<div class="analysis-text">This assessment-focused report combines continuous evaluation, subject mastery, attendance, and teacher recommendations for targeted learner support.</div>
</div>
{{/if}}
{{#if isSelectionVariant}}
<div class="analysis-box avoid-break" style="border-color:{{primaryColor}};background:{{secondaryColor}};">
<div class="analysis-title" style="color:{{primaryColor}}">Selection & Placement Readiness</div>
<div class="analysis-text">The learner's academic profile, class position, best-subject aggregate, and attendance are presented for secondary-school selection decisions.</div>
</div>
{{/if}}
{{#if isExaminationVariant}}
<div class="analysis-box avoid-break" style="border-color:{{primaryColor}};background:{{secondaryColor}};">
<div class="analysis-title" style="color:{{primaryColor}}">Examination Readiness</div>
<div class="analysis-text">Use this examination report to review subject strengths, priority areas, grade distribution, and readiness for the next assessment milestone.</div>
</div>
{{/if}}
{{#if isAdvancedVariant}}
<div class="analysis-box avoid-break" style="border-color:{{primaryColor}};background:{{secondaryColor}};">
<div class="analysis-title" style="color:{{primaryColor}}">Advanced Secondary University Readiness</div>
<div class="analysis-text">The best-subject aggregate, performance trends, and class standing provide an advanced-secondary view of university preparation.</div>
</div>
{{/if}}
{{#if isTranscriptVariant}}
<div class="analysis-box avoid-break" style="border-color:{{primaryColor}};background:{{secondaryColor}};">
<div class="analysis-title" style="color:{{primaryColor}}">Academic Record Verification</div>
<div class="analysis-text">This verified academic record preserves the learner's subject results, grading profile, attendance, and institutional remarks for official reference.</div>
</div>
{{/if}}
{{#if isForm1Variant}}<div class="analysis-box avoid-break" style="border-color:{{primaryColor}};background:{{secondaryColor}};"><div class="analysis-title" style="color:{{primaryColor}}">Foundation Skills Profile</div><div class="analysis-text">Form 1 results establish the learner's foundation across core subjects and identify support priorities for the secondary phase.</div></div>{{/if}}
{{#if isForm2Variant}}<div class="analysis-box avoid-break" style="border-color:{{primaryColor}};background:{{secondaryColor}};"><div class="analysis-title" style="color:{{primaryColor}}">Progression & Mastery Review</div><div class="analysis-text">Form 2 results track progression from foundational learning toward stronger subject mastery and independent study habits.</div></div>{{/if}}
{{#if isGrade10Variant}}<div class="analysis-box avoid-break" style="border-color:{{primaryColor}};background:{{secondaryColor}};"><div class="analysis-title" style="color:{{primaryColor}}">Career Pathway Snapshot</div><div class="analysis-text">Grade 10 performance highlights subject strengths that can guide senior-secondary choices and future career pathways.</div></div>{{/if}}
{{#if isGrade11Variant}}<div class="analysis-box avoid-break" style="border-color:{{primaryColor}};background:{{secondaryColor}};"><div class="analysis-title" style="color:{{primaryColor}}">University Preparation Snapshot</div><div class="analysis-text">Grade 11 results provide an early university-preparation view through subject performance, aggregate points, and attendance.</div></div>{{/if}}
{{#if isGrade12Variant}}<div class="analysis-box avoid-break" style="border-color:{{primaryColor}};background:{{secondaryColor}};"><div class="analysis-title" style="color:{{primaryColor}}">Graduation & University Readiness</div><div class="analysis-text">Grade 12 performance summarizes final academic readiness, eligibility indicators, and areas requiring attention before graduation.</div></div>{{/if}}

<!-- Subject Results Table -->
<div class="section avoid-break">
<div class="section-title">Subject Results</div>
<table>
<tr>
<th style="width:22px">#</th>
<th style="text-align:left">Subject</th>
<th>Score</th>
<th>%</th>
<th>Grade</th>
<th>Pts</th>
<th>Rank</th>
<th>Performance</th>
{{#if showRemarks}}<th>Remark</th>{{/if}}
</tr>
{{#each subjectBreakdown}}
<tr>
<td>{{math @index "+" 1}}</td>
<td class="subject-name">{{subjectName}}</td>
<td>{{#if (present totalRawScore)}}{{totalRawScore}}{{else}}—{{/if}}</td>
<td><strong>{{#if (present finalPercentage)}}{{finalPercentage}}{{else}}—{{/if}}%</strong></td>
<td>{{#if finalGrade}}{{finalGrade}}{{else}}—{{/if}}</td>
<td>{{#if (present points)}}{{points}}{{else}}—{{/if}}</td>
<td>{{#if (present subjectRank)}}{{subjectRank}}{{else}}—{{/if}}</td>
<td>
{{#if performanceCategory}}
<span class="perf-cat" style="background:{{performanceCategory.color}}25; color:{{performanceCategory.color}}">{{performanceCategory.label}}</span>
{{else}}—{{/if}}
</td>
{{#if ../showRemarks}}<td style="font-size:10px">{{#if finalRemark}}{{finalRemark}}{{else}}—{{/if}}</td>{{/if}}
</tr>
{{/each}}
</table>
</div>

<!-- Charts Row: Bar Chart + Pie Chart — kept together -->
<div class="charts-row avoid-break">
<!-- Bar Chart: Subject Scores -->
<div class="chart-card">
<div class="chart-title">Subject Score Comparison</div>
<div class="bar-chart">
{{#each subjectBreakdown}}
<div class="bar-row">
<div class="bar-label" title="{{subjectName}}">{{subjectName}}</div>
<div class="bar-track">
<div class="bar-fill {{#if (gte finalPercentage 70)}}excellent{{else if (gte finalPercentage 55)}}good{{else if (gte finalPercentage 40)}}average{{else}}below{{/if}}" style="width:{{#if (present finalPercentage)}}{{finalPercentage}}{{else}}0{{/if}}%">{{#if (present finalPercentage)}}{{finalPercentage}}%{{/if}}</div>
</div>
</div>
{{/each}}
</div>
{{#if classAverage}}
<div style="text-align:center; margin-top:4px; font-size:10px; color:#374151">
<span style="display:inline-block; width:7px; height:7px; background:#111827; border-radius:1px; vertical-align:middle; margin-right:2px"></span>
Class Average: <strong>{{classAverage}}%</strong>
</div>
{{/if}}
</div>

<!-- Pie Chart: Grade Distribution -->
<div class="chart-card">
<div class="chart-title">Grade Distribution</div>
{{#if gradeDistribution}}
<div class="pie-container">
<div class="pie-chart" style="background: conic-gradient({{#each gradeDistribution}}{{color}} {{startAngle}}deg {{endAngle}}deg{{#unless @last}},{{/unless}}{{/each}});">
<div class="pie-center">{{subjectBreakdown.length}}<br><span style="font-size:8px;font-weight:400">subjects</span></div>
</div>
<div class="pie-legend">
{{#each gradeDistribution}}
<div class="legend-item">
<div class="legend-dot" style="background:{{color}}"></div>
<span>{{grade}}: {{count}} ({{percentage}}%)</span>
</div>
{{/each}}
</div>
</div>
{{else}}
<div style="text-align:center; padding:15px; color:#4b5563; font-size:11px">No grade data available</div>
{{/if}}
</div>
</div>

<!-- Histogram: Score Distribution -->
{{#if histogramData}}
<div class="section avoid-break">
<div class="chart-title">Score Distribution by Grade</div>
<div style="background:#f8f9fc; border:1px solid #e2e8f0; border-radius:6px; padding:8px;">
<div class="histogram">
{{#each histogramData}}
<div class="hist-bar">
<div class="hist-count">{{count}}</div>
<div class="hist-fill" style="height:{{barHeight}}px; background:{{color}};"></div>
<div class="hist-label">{{label}}</div>
</div>
{{/each}}
</div>
<div style="text-align:center; margin-top:3px; font-size:9px; color:#374151">← Lower Grades | Grade Ranges | Higher Grades →</div>
</div>
</div>
{{/if}}

<!-- Best Subjects / Primary subject leaders -->
{{#if isPrimarySchool}}
{{#unless isGrade7Ecz}}
{{#if bestSubjects}}
<div class="section avoid-break"><div class="section-title">Top Performing Subjects</div><div class="best-grid">{{#each bestSubjects}}<div class="best-item"><div class="best-subject">{{subjectName}}</div><div class="best-score">{{#if (present finalPercentage)}}{{finalPercentage}}%{{else}}—{{/if}}</div><div style="font-size:9px;color:#374151">{{finalGrade}}</div></div>{{/each}}</div></div>
{{/if}}
{{/unless}}
{{else}}
{{#if bestSubjects}}
<div class="section avoid-break">
<div class="section-title">Best {{bestSubjects.length}} Subjects</div>
<div class="best-grid">
{{#each bestSubjects}}
<div class="best-item {{#if @first}}top{{/if}}">
<div class="best-subject">{{subjectName}}</div>
<div class="best-score">{{#if (present finalPercentage)}}{{finalPercentage}}%{{else}}—{{/if}}</div>
<div style="font-size:9px; color:#374151">{{#if (present points)}}{{points}} pts{{else}}— pts{{/if}}</div>
{{#if performanceCategory}}<span class="perf-cat" style="background:{{performanceCategory.color}}25; color:{{performanceCategory.color}}; font-size:9px">{{performanceCategory.label}}</span>{{/if}}
</div>
{{/each}}
</div>
</div>
{{/if}}
{{/if}}


<!-- ==================== PAGE 2: COMPARISON & ANALYSIS ==================== -->

<!-- Mid-Term / Previous Term Comparison -->
{{#if midTermData}}
<div class="section avoid-break">
<div class="section-title">Performance Comparison — {{midTermData.termName}} vs {{termName}}</div>
<div class="comparison-grid">
<div class="comparison-card">
  <div class="comparison-title">Term-over-Term Summary</div>
  <div class="comparison-row"><span>Overall Score:</span> <span>{{midTermData.overallPercentage}}% → {{termSummary.overallPercentage}}% 
    {{#if (gt termSummary.overallPercentage midTermData.overallPercentage)}}<span class="trend-up">▲ +{{minus termSummary.overallPercentage midTermData.overallPercentage}}%</span>
    {{else if (lt termSummary.overallPercentage midTermData.overallPercentage)}}<span class="trend-down">▼ {{minus termSummary.overallPercentage midTermData.overallPercentage}}%</span>
    {{else}}<span class="trend-same">— Same</span>{{/if}}
  </span></div>
  {{#if midTermData.overallGrade}}<div class="comparison-row"><span>Grade:</span> <span>{{midTermData.overallGrade}} → {{termSummary.overallGrade}}</span></div>{{/if}}
  {{#if midTermData.classRank}}<div class="comparison-row"><span>Class Rank:</span> <span>{{midTermData.classRank}} → {{termSummary.classRank}}</span></div>{{/if}}
  <div class="comparison-row"><span>Attendance:</span> <span>{{midTermData.attendanceRate}}% → {{attendance.attendanceRate}}%</span></div>
</div>

<div class="comparison-card">
  <div class="comparison-title">Subject-Level Changes</div>
  {{#each midTermData.subjectComparisons}}
  <div class="comparison-row">
    <span>{{subjectName}}:</span>
    <span>{{previousPercentage}}% → {{currentPercentage}}%
      {{#if (gt currentPercentage previousPercentage)}}<span class="trend-up"> ▲</span>
      {{else if (lt currentPercentage previousPercentage)}}<span class="trend-down"> ▼</span>
      {{else}}<span class="trend-same"> —</span>{{/if}}
    </span>
  </div>
  {{/each}}
</div>
</div>
</div>
{{/if}}

<!-- Class Average Comparison Chart -->
{{#if classComparison}}
<div class="section avoid-break">
<div class="section-title">Your Performance vs Class Average</div>
<div style="background:#f8f9fc; border:1px solid #e2e8f0; border-radius:6px; padding:8px;">
<div class="bar-chart">
{{#each classComparison}}
<div class="bar-row">
<div class="bar-label">{{subjectName}}</div>
<div class="bar-track" style="position:relative">
<div class="bar-fill {{#if (gte studentScore 70)}}excellent{{else if (gte studentScore 55)}}good{{else if (gte studentScore 40)}}average{{else}}below{{/if}}" style="width:{{studentScore}}%; opacity:0.85">{{studentScore}}%</div>
<div class="bar-avg" style="left:{{classAverage}}%"></div>
</div>
</div>
{{/each}}
</div>
<div style="text-align:center; margin-top:4px; font-size:10px; color:#374151">
<span style="display:inline-block; width:10px; height:6px; background:#3b82f680; border-radius:2px; vertical-align:middle; margin-right:2px"></span> Your Score &nbsp;&nbsp;
<span style="display:inline-block; width:10px; height:2px; background:#111827; vertical-align:middle; margin-right:2px"></span> Class Average
</div>
</div>
</div>
{{/if}}

<!-- Parent-Friendly Analysis -->
<div class="analysis-box avoid-break">
<div class="analysis-title">Performance Analysis for Parents</div>
<div class="analysis-text">

{{#if termSummary.strengths}}
<div style="margin-bottom:4px"><strong style="color:#166534">Strengths:</strong></div>
{{#each termSummary.strengths}}
<div class="strength-item">{{this}}</div>
{{/each}}
{{/if}}

{{#if termSummary.weaknesses}}
<div style="margin-top:4px; margin-bottom:4px"><strong style="color:#b45309">Areas for Improvement:</strong></div>
{{#each termSummary.weaknesses}}
<div class="weakness-item">{{this}}</div>
{{/each}}
{{/if}}

{{#if termSummary.aiInsights}}
<div style="margin-top:6px; padding:5px; background: #eff6ff; border-radius:4px; border-left:3px solid #1d4ed8;">
<strong style="color:#1e3a8a">Insights:</strong>
{{#each termSummary.aiInsights}}
<div style="margin-top:2px; font-size:11px; color:#1e3a8a;">• {{this}}</div>
{{/each}}
</div>
{{/if}}

{{#unless termSummary.strengths}}{{#unless termSummary.weaknesses}}{{#unless termSummary.aiInsights}}
<div style="padding:5px; background:#f0fdf4; border-radius:4px; border-left:3px solid #22c55e;">
<strong style="color:#166534">Summary:</strong> 
{{#if (gte termSummary.overallPercentage 70)}}
Your child has performed excellently this term with an overall score of {{termSummary.overallPercentage}}%. 
{{#if attendance.attendanceRate}}With an attendance rate of {{attendance.attendanceRate}}%, {{student.firstName}} has shown strong commitment to their studies.{{/if}}
We encourage continued effort to maintain this high standard.
{{else if (gte termSummary.overallPercentage 55)}}
Your child has performed well this term with an overall score of {{termSummary.overallPercentage}}%. 
There is room for improvement in some areas. {{#if attendance.attendanceRate}}With an attendance rate of {{attendance.attendanceRate}}%, consistent class attendance will help improve performance further.{{/if}}
Please discuss the areas marked for improvement with your child.
{{else if (gte termSummary.overallPercentage 40)}}
Your child has shown moderate performance this term with an overall score of {{termSummary.overallPercentage}}%. 
We recommend additional study time and possibly tutoring in weaker subjects. {{#if attendance.attendanceRate}}An attendance rate of {{attendance.attendanceRate}}% {{#if (lt attendance.attendanceRate 80)}}indicates room for improvement in school attendance{{/if}}{{/if}}. 
Please contact the class teacher for a detailed discussion.
{{else}}
Your child's performance this term ({{termSummary.overallPercentage}}%) indicates that additional support is needed. 
We strongly recommend a parent-teacher meeting to discuss strategies for improvement. {{#if attendance.attendanceRate}}The attendance rate of {{attendance.attendanceRate}}% {{#if (lt attendance.attendanceRate 80)}}needs significant improvement{{/if}}{{/if}}.
Together, we can help {{student.firstName}} achieve better results.
{{/if}}
</div>
{{/unless}}{{/unless}}{{/unless}}

</div>
</div>

<!-- Comments -->
<div class="comments-section avoid-break">
<div class="section-title">Teacher & Head Teacher Comments</div>
{{#if teacherComment}}
<div class="comment-box">
<div class="comment-label">Class Teacher's Remarks:</div>
<div class="comment-text">{{teacherComment}}</div>
</div>
{{/if}}
{{#if headComment}}
<div class="comment-box">
<div class="comment-label">Head Teacher's Remarks:</div>
<div class="comment-text">{{headComment}}</div>
</div>
{{/if}}
{{#unless teacherComment}}{{#unless headComment}}
<div class="comment-box">
<div class="comment-text" style="color:#4b5563; font-style:italic">No comments available for this term.</div>
</div>
{{/unless}}{{/unless}}
</div>

<!-- Grading Legend -->
<div class="section avoid-break">
<div class="section-title">Grading Legend</div>
<table class="legend-table">
<tr>
{{#each gradingLegend}}
<th style="background:{{color}}">{{grade}}</th>
{{/each}}
</tr>
<tr>
{{#each gradingLegend}}
<td style="background:{{color}}15"><strong>{{range}}</strong><br/>{{label}}</td>
{{/each}}
</tr>
</table>
</div>

<!-- Curriculum Info -->
{{#if curriculum.version}}
<div style="text-align:center; font-size:10px; color:#4b5563; margin-top:6px">
Curriculum: {{curriculum.version}}{{#if curriculum.bestSubjectRule.name}} • Best Subject Rule: {{curriculum.bestSubjectRule.name}}{{/if}}
</div>
{{/if}}

<!-- Footer -->
<div class="footer avoid-break">
<div class="signature-section">
{{#if includeSignature}}{{#if signatureUrl}}<img src="{{signatureUrl}}" class="stamp-image" style="max-height:35px; margin-bottom:2px"/>{{/if}}{{/if}}
<div class="signature-line"></div>
<div style="font-size:10px; margin-top:3px; font-weight:600">Class Teacher</div>
</div>
<div class="stamp-section">
{{#if includeStamp}}{{#if stampUrl}}<img src="{{stampUrl}}" class="stamp-image"/>{{/if}}{{/if}}
</div>
<div class="signature-section">
{{#if includeSignature}}{{#if signatureUrl}}<img src="{{signatureUrl}}" class="stamp-image" style="max-height:35px; margin-bottom:2px"/>{{/if}}{{/if}}
<div class="signature-line"></div>
<div style="font-size:10px; margin-top:3px; font-weight:600">{{#if directorName}}{{directorName}}{{else}}Head Teacher{{/if}}</div>
</div>
</div>

{{#if footerText}}<div class="footer-text">{{footerText}}</div>{{/if}}
<div class="footer-text">Generated on {{generatedAtFormatted}} | {{schoolName}} — Smart Results Management System</div>

</body>
</html>
