<div style="font-size:8px; margin-top:3px">Class Teacher</div>
</div>
<div class="stamp-section">
{{#if includeStamp}}{{#if stampUrl}}<img src="{{stampUrl}}" class="stamp-image"/>{{/if}}{{/if}}
</div>
<div class="signature-section">
{{#if includeSignature}}{{#if signatureUrl}}<img src="{{signatureUrl}}" class="stamp-image" style="max-height:35px; margin-bottom:2px"/>{{/if}}{{/if}}
<div class="signature-line"></div>
<div style="font-size:8px; margin-top:3px">{{#if directorName}}{{directorName}}{{else}}Head Teacher{{/if}}</div>
</div>
</div>

{{#if footerText}}<div class="footer-text">{{footerText}}</div>{{/if}}
<div class="footer-text">Generated on {{generatedAtFormatted}} | {{schoolName}} — Smart Results Management System</div>

