<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <title>{{schoolName}} - Certificate</title>
  <style>
    @page { size: {{pageSize}} {{orientation}}; margin: 0; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: '{{fontFamily}}', Georgia, serif; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .certificate-wrapper { width: 100%; min-height: {{pageHeight}}; display: flex; align-items: center; justify-content: center; padding: 40px; }
    .certificate { width: 100%; min-height: {{innerHeight}}; border: {{borderStyle}}; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 40px; position: relative; background: white; }
    {{#if showWatermark}}
    .watermark { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%) rotate(-30deg); font-size: 80px; color: {{borderColor}}; opacity: 0.04; pointer-events: none; white-space: nowrap; font-weight: bold; }
    {{/if}}
    .logo { height: 70px; margin-bottom: 10px; }
    .school-name { font-size: 28px; font-weight: bold; color: {{borderColor}}; margin-bottom: 5px; }
    .cert-title { font-size: 11px; color: #666; margin-bottom: 20px; text-transform: uppercase; letter-spacing: 4px; }
    .divider { width: 200px; border: 1px solid {{borderColor}}; margin: 15px auto; }
    .award-text { font-size: 15px; color: #555; margin: 10px 0; }
    .student-name { font-size: 36px; font-weight: bold; color: {{borderColor}}; margin: 10px 0; font-family: 'Georgia', serif; }
    .detail-text { font-size: 13px; color: #555; margin: 5px 0; }
    .badge { margin: 15px 0; }
    .signatures { display: flex; justify-content: space-around; width: 80%; margin-top: 30px; }
    .signature-box { text-align: center; }
    .signature-line { border-top: 1px solid #333; width: 180px; margin-bottom: 5px; padding-top: 5px; }
    .signature-label { font-size: 10px; color: #666; }
    .cert-number { font-size: 9px; color: #999; margin-top: 15px; }
    @media print { .certificate-wrapper { padding: 0; } }
  </style>
</head>
<body>
  <div class="certificate-wrapper">
    <div class="certificate">
      {{#if showWatermark}}<div class="watermark">{{watermarkText}}</div>{{/if}}
      {{#if schoolLogo}}<img src="{{schoolLogo}}" class="logo"/>{{/if}}
      <div class="school-name">{{schoolName}}</div>
      <div class="cert-title">Certificate of Achievement</div>
      <hr class="divider"/>
      <div class="award-text">{{awardText}}</div>
      <div class="student-name">{{studentName}}</div>
      <div class="detail-text">For outstanding academic performance</div>
      <div class="detail-text">Class: {{className}} | Term: {{termName}} {{academicYear}}</div>
      {{#if showBadge}}
      <div class="badge">
        <svg width="50" height="50" viewBox="0 0 50 50">
          <polygon points="25,3 31,18 47,19 35,30 38,47 25,38 12,47 15,30 3,19 19,18" fill="#f59e0b"/>
        </svg>
      </div>
      {{/if}}
      {{#if showQrCode}}
      <div style="margin:10px 0;">
        <svg width="50" height="50" viewBox="0 0 50 50">
          <rect width="50" height="50" fill="white"/>
          <rect x="8" y="8" width="6" height="6" fill="black"/>
          <rect x="8" y="20" width="6" height="6" fill="black"/>
          <rect x="8" y="32" width="6" height="6" fill="black"/>
          <rect x="20" y="8" width="6" height="6" fill="black"/>
          <rect x="32" y="8" width="6" height="6" fill="black"/>
          <rect x="32" y="20" width="6" height="6" fill="black"/>
          <rect x="32" y="32" width="6" height="6" fill="black"/>
          <rect x="20" y="32" width="6" height="6" fill="black"/>
        </svg>
      </div>
      {{/if}}
      <div class="signatures">
        <div class="signature-box">
          <div class="signature-line">{{signature1Name}}</div>
          <div class="signature-label">{{signature1Label}}</div>
        </div>
        <div class="signature-box">
          <div class="signature-line">{{signature2Name}}</div>
          <div class="signature-label">{{signature2Label}}</div>
        </div>
      </div>
      <div class="cert-number">Certificate No: {{certificateNumber}}</div>
    </div>
  </div>
</body>
</html>
