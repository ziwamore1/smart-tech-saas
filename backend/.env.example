# SMART_TECH SAAS SYSTEM - Backend Environment Variables
# Copy this file to .env and fill in your values

# ==========================================
# DATABASE
# ==========================================
DATABASE_URL=postgresql://user:password@localhost:5432/school_saas

# ==========================================
# APPLICATION
# ==========================================
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ==========================================
# JWT AUTHENTICATION
# ==========================================
JWT_SECRET=change-this-to-a-secure-random-string-min-32-characters
JWT_EXPIRES_IN=7d

# ==========================================
# VERIFICATION
# ==========================================
VERIFICATION_URL=https://verify.smarttechsaas.com

# ==========================================
# MINISTRY APIs - ZAMBIA
# ==========================================
MINISTRY_ZAMBIA_ENABLED=false
MINISTRY_ZAMBIA_API_URL=https://api.mineduc.gov.zm
MINISTRY_ZAMBIA_CLIENT_ID=
MINISTRY_ZAMBIA_CLIENT_SECRET=
MINISTRY_ZAMBIA_JWT_SECRET=
MINISTRY_ZAMBIA_TIMEOUT=30000

# ==========================================
# MINISTRY APIs - KENYA
# ==========================================
MINISTRY_KENYA_ENABLED=false
MINISTRY_KENYA_API_URL=
MINISTRY_KENYA_CLIENT_ID=
MINISTRY_KENYA_CLIENT_SECRET=
MINISTRY_KENYA_JWT_SECRET=
MINISTRY_KENYA_TIMEOUT=30000

# ==========================================
# MINISTRY APIs - SOUTH AFRICA
# ==========================================
MINISTRY_SOUTH_AFRICA_ENABLED=false
MINISTRY_SOUTH_AFRICA_API_URL=
MINISTRY_SOUTH_AFRICA_CLIENT_ID=
MINISTRY_SOUTH_AFRICA_CLIENT_SECRET=
MINISTRY_SOUTH_AFRICA_JWT_SECRET=
MINISTRY_SOUTH_AFRICA_TIMEOUT=30000

# ==========================================
# MINISTRY CUSTOM ADAPTERS (JSON)
# ==========================================
# Example:
# MINISTRY_CUSTOM_ADAPTERS=[{"country":"GH","enabled":true,"config":{"apiUrl":"https://api.moe.gov.gh","clientId":"xxx","clientSecret":"xxx","jwtSecret":"xxx","timeout":30000,"authMethod":"oauth2","authEndpoint":"/oauth2/token","verifyEndpoint":"/api/v1/verify","registerEndpoint":"/api/v1/institutions","statusEndpoint":"/api/v1/verify/status"}}]
MINISTRY_CUSTOM_ADAPTERS=[]

# ==========================================
# MINISTRY WEBHOOK
# ==========================================
MINISTRY_WEBHOOK_SECRET=

# ==========================================
# BLOCKCHAIN
# ==========================================
CONTRACT_ADDRESS=
PRIVATE_KEY=
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGONSCAN_API_KEY=

# ==========================================
# EMAIL
# ==========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SmartTech SaaS

# MailJet API (alternative to SMTP/SendGrid)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# ==========================================
# TWILIO (SMS - Cost-effective alternative)
# ==========================================
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# ==========================================
# BEEM AFRICA (SMS & WhatsApp)
# ==========================================
BEEM_ENABLED=false
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_NAME=SmartTech

# ==========================================
# REDIS (Optional - for queues)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# CLOUDINARY (Required in production - for media storage)
# ==========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=smart_tech

# ==========================================
# SENTRY (Optional - error tracking)
# ==========================================
SENTRY_DSN=

# ==========================================
# AWS S3 (Deprecated - migrating to Cloudinary)
# ==========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
