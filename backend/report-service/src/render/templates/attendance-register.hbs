<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8" />
<title>Daily Attendance Register - {{className}} - {{date}}</title>
<style>
  @page { margin: 12mm 10mm; size: A4 landscape; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Segoe UI', Arial, Helvetica, sans-serif; font-size: 10px; color: #1f2937; line-height: 1.4; }

  table.attendance { width: 100%; border-collapse: collapse; margin-top: 12px; }
  table.attendance th { background: {{primaryColor}}; color: white; padding: 6px 8px; font-size: 9px; font-weight: 600; text-align: center; text-transform: uppercase; letter-spacing: 0.5px; }
  table.attendance td { padding: 5px 8px; text-align: center; border-bottom: 1px solid #e5e7eb; font-size: 10px; }
  table.attendance tr:nth-child(even) { background: #f9fafb; }
  table.attendance .student-name { text-align: left; font-weight: 600; }

  .status-present { color: #059669; font-weight: 700; }
  .status-absent { color: #dc2626; font-weight: 700; }
  .status-late { color: #ea580c; font-weight: 700; }
  .status-excused { color: #2563eb; font-weight: 700; }
  .status-sick { color: #ca8a04; font-weight: 700; }
  .status-suspended { color: #6b7280; font-weight: 700; }
  .status-activity { color: #7c3aed; font-weight: 700; }
  .status-partial { color: #0d9488; font-weight: 700; }

  .summary-bar { display: flex; gap: 8px; margin: 10px 0; flex-wrap: wrap; }
  .summary-item { padding: 6px 12px; border-radius: 4px; font-size: 10px; font-weight: 600; }
  .summary-item.present { background: #f0fdf4; color: #059669; border: 1px solid #bbf7d0; }
  .summary-item.absent { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }
  .summary-item.late { background: #fff7ed; color: #ea580c; border: 1px solid #fed7aa; }
  .summary-item.excused { background: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe; }
  .summary-item.sick { background: #fefce8; color: #ca8a04; border: 1px solid #fef08a; }
  .summary-item.suspended { background: #f3f4f6; color: #6b7280; border: 1px solid #d1d5db; }
  .summary-item.activity { background: #faf5ff; color: #7c3aed; border: 1px solid #e9d5ff; }
  .summary-item.partial { background: #f0fdfa; color: #0d9488; border: 1px solid #a7f3d0; }
  .summary-item.unmarked { background: #f9fafb; color: #9ca3af; border: 1px solid #e5e7eb; }

  .student-photo { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 2px solid #e5e7eb; vertical-align: middle; }
  .student-photo-placeholder { width: 32px; height: 32px; border-radius: 50%; background: #f3f4f6; border: 2px solid #e5e7eb; display: inline-flex; align-items: center; justify-content: center; font-size: 10px; color: #9ca3af; vertical-align: middle; }

  .footer { margin-top: 20px; font-size: 9px; color: #9ca3af; text-align: center; border-top: 1px solid #e5e7eb; padding-top: 10px; }

  @media print {
    body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>
</head>
<body>

{{> header primaryColor=template.primaryColor secondaryColor=template.secondaryColor }}

<div class="summary-bar">
  <div class="summary-item present">Present: {{stats.present}}</div>
  <div class="summary-item absent">Absent: {{stats.absent}}</div>
  <div class="summary-item late">Late: {{stats.late}}</div>
  <div class="summary-item excused">Excused: {{stats.excused}}</div>
  <div class="summary-item sick">Sick: {{stats.sick}}</div>
  <div class="summary-item suspended">Suspended: {{stats.suspended}}</div>
  <div class="summary-item activity">Activity: {{stats.activity}}</div>
  <div class="summary-item partial">Partial: {{stats.partial}}</div>
  <div class="summary-item unmarked">Unmarked: {{stats.unmarked}}</div>
  <div><strong>Total:</strong> {{stats.total}} students</div>
</div>

<table class="attendance">
  <thead>
    <tr>
      <th>#</th>
      <th style="width:42px;">Photo</th>
      <th>Admission</th>
      <th>Student Name</th>
      <th>Status</th>
      <th>Check In</th>
      <th>Check Out</th>
      <th>Remarks</th>
    </tr>
  </thead>
  <tbody>
    {{#each records}}
    <tr>
      <td>{{inc @index}}</td>
      <td>
        {{#if photoUrl}}
        <img src="{{photoUrl}}" alt="{{name}}" class="student-photo" />
        {{else}}
        <span class="student-photo-placeholder">—</span>
        {{/if}}
      </td>
      <td>{{admNo}}</td>
      <td class="student-name">{{name}}</td>
      <td class="status-{{status}}">{{statusLabel}}</td>
      <td>{{checkIn}}</td>
      <td>{{checkOut}}</td>
      <td>{{remarks}}</td>
    </tr>
    {{/each}}
  </tbody>
</table>

<div class="footer">Generated on {{generatedAt}} | {{schoolName}}</div>

</body>
</html>
