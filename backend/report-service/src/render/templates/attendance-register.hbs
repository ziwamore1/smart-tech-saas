<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8" />
<title>Daily Attendance Register - {{className}} - {{date}}</title>
<style>
  @page { margin: 12mm 10mm; size: A4 landscape; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Segoe UI', Arial, Helvetica, sans-serif; font-size: 12px; color: #111827; line-height: 1.4; }

  table.attendance { width: 100%; border-collapse: collapse; margin-top: 12px; }
  table.attendance th { background: #1f2937; color: #ffffff; padding: 6px 8px; font-size: 11px; font-weight: 700; text-align: center; text-transform: uppercase; letter-spacing: 0.5px; border: 1px solid #111827; }
  table.attendance td { padding: 5px 8px; text-align: center; border: 1px solid #9ca3af; border-bottom-width: 1.5px; font-size: 11px; }
  table.attendance tr:nth-child(even) { background: #f3f4f6; }
  table.attendance .student-name { text-align: left; font-weight: 600; }

  .status-present { color: #065f46; font-weight: 700; }
  .status-absent { color: #991b1b; font-weight: 700; }
  .status-late { color: #9a3412; font-weight: 700; }
  .status-excused { color: #1e40af; font-weight: 700; }
  .status-sick { color: #854d0e; font-weight: 700; }
  .status-suspended { color: #374151; font-weight: 700; }
  .status-activity { color: #5b21b6; font-weight: 700; }
  .status-partial { color: #0f766e; font-weight: 700; }

  .summary-bar { display: flex; gap: 8px; margin: 10px 0; flex-wrap: wrap; }
  .summary-item { padding: 6px 12px; border-radius: 4px; font-size: 11px; font-weight: 700; }
  .summary-item.present { background: #d1fae5; color: #065f46; border: 1px solid #059669; }
  .summary-item.absent { background: #fecaca; color: #991b1b; border: 1px solid #dc2626; }
  .summary-item.late { background: #fed7aa; color: #9a3412; border: 1px solid #ea580c; }
  .summary-item.excused { background: #bfdbfe; color: #1e40af; border: 1px solid #3b82f6; }
  .summary-item.sick { background: #fef08a; color: #854d0e; border: 1px solid #ca8a04; }
  .summary-item.suspended { background: #e5e7eb; color: #374151; border: 1px solid #9ca3af; }
  .summary-item.activity { background: #e9d5ff; color: #5b21b6; border: 1px solid #a855f7; }
  .summary-item.partial { background: #99f6e4; color: #0f766e; border: 1px solid #14b8a6; }
  .summary-item.unmarked { background: #f3f4f6; color: #4b5563; border: 1px solid #9ca3af; }

  .student-photo { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 2px solid #6b7280; vertical-align: middle; }
  .student-photo-placeholder { width: 32px; height: 32px; border-radius: 50%; background: #e5e7eb; border: 2px solid #6b7280; display: inline-flex; align-items: center; justify-content: center; font-size: 10px; color: #374151; vertical-align: middle; }

  .footer { margin-top: 20px; font-size: 10px; color: #4b5563; text-align: center; border-top: 1px solid #9ca3af; padding-top: 10px; }

  @media print {
    body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>
</head>
<body>

{{> header primaryColor=template.primaryColor secondaryColor=template.secondaryColor }}

<div class="summary-bar">
  <div class="summary-item present">Present: {{stats.present}}</div>
  <div class="summary-item absent">Absent: {{stats.absent}}</div>
  <div class="summary-item late">Late: {{stats.late}}</div>
  <div class="summary-item excused">Excused: {{stats.excused}}</div>
  <div class="summary-item sick">Sick: {{stats.sick}}</div>
  <div class="summary-item suspended">Suspended: {{stats.suspended}}</div>
  <div class="summary-item activity">Activity: {{stats.activity}}</div>
  <div class="summary-item partial">Partial: {{stats.partial}}</div>
  <div class="summary-item unmarked">Unmarked: {{stats.unmarked}}</div>
  <div><strong>Total:</strong> {{stats.total}} students</div>
</div>

<table class="attendance">
  <thead>
    <tr>
      <th>#</th>
      <th style="width:42px;">Photo</th>
      <th>Admission</th>
      <th>Student Name</th>
      <th>Status</th>
      <th>Check In</th>
      <th>Check Out</th>
      <th>Remarks</th>
    </tr>
  </thead>
  <tbody>
    {{#each records}}
    <tr>
      <td>{{inc @index}}</td>
      <td>
        {{#if photoUrl}}
        <img src="{{photoUrl}}" alt="{{name}}" class="student-photo" />
        {{else}}
        <span class="student-photo-placeholder">—</span>
        {{/if}}
      </td>
      <td>{{admNo}}</td>
      <td class="student-name">{{name}}</td>
      <td class="status-{{status}}">{{statusLabel}}</td>
      <td>{{checkIn}}</td>
      <td>{{checkOut}}</td>
      <td>{{remarks}}</td>
    </tr>
    {{/each}}
  </tbody>
</table>

<div class="footer">Generated on {{generatedAt}} | {{schoolName}}</div>

</body>
</html>
