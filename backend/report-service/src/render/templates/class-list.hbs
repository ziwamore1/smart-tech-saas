<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8" />
<title>Class List - {{className}}</title>
<style>
  @page { margin: 15mm 10mm; size: A4; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Segoe UI', Arial, Helvetica, sans-serif; font-size: 11px; color: #111827; line-height: 1.35; }

  .school-header { text-align: center; margin-bottom: 12px; padding-bottom: 10px; border-bottom: 3px solid {{primaryColor}}; page-break-inside: avoid; }
  .school-header h1 { font-size: 20px; font-weight: 800; color: {{primaryColor}}; margin: 0; overflow-wrap: anywhere; }
  .school-header p { font-size: 11px; color: #374151; margin: 3px 0 0; overflow-wrap: anywhere; }

  .report-title { text-align: center; margin-bottom: 10px; page-break-inside: avoid; }
  .report-title h2 { font-size: 17px; font-weight: 800; color: #111827; margin: 0; overflow-wrap: anywhere; }
  .report-title p { font-size: 10px; color: #374151; margin: 2px 0 0; overflow-wrap: anywhere; }

  .meta-grid { width: 100%; border-collapse: collapse; margin-bottom: 10px; table-layout: fixed; page-break-inside: avoid; }
  .meta-grid td { padding: 5px 8px; border: 1px solid #d1d5db; background: #f9fafb; font-size: 10px; vertical-align: top; overflow-wrap: anywhere; word-break: break-word; white-space: normal; }
  .meta-grid .label { font-weight: 700; color: #374151; text-transform: uppercase; letter-spacing: 0.3px; width: 15%; }
  .meta-grid .value { color: #111827; font-weight: 600; }

  .summary-grid { width: 100%; border-collapse: collapse; margin-bottom: 10px; table-layout: fixed; page-break-inside: avoid; }
  .summary-grid td { text-align: center; padding: 7px 6px; border: 1px solid #9ca3af; vertical-align: middle; }
  .summary-grid .card-value { font-size: 17px; font-weight: 800; overflow-wrap: anywhere; word-break: break-word; }
  .summary-grid .card-label { font-size: 9px; color: #374151; text-transform: uppercase; letter-spacing: 0.3px; margin-top: 2px; font-weight: 700; overflow-wrap: anywhere; word-break: break-word; }
  .summary-grid .total { background: #f3f4f6; } .summary-grid .total .card-value { color: {{primaryColor}}; }
  .summary-grid .male { background: #dbeafe; } .summary-grid .male .card-value { color: #1d4ed8; }
  .summary-grid .female { background: #fce7f3; } .summary-grid .female .card-value { color: #be185d; }
  .summary-grid .other { background: #fef3c7; } .summary-grid .other .card-value { color: #92400e; }
  .summary-grid .capacity { background: #d1fae5; } .summary-grid .capacity .card-value { color: #047857; }
  .summary-grid .warning { background: #fee2e2; } .summary-grid .warning .card-value { color: #b91c1c; }

  .stats-line { margin-bottom: 10px; padding: 7px 9px; background: #f3f4f6; border: 1px solid #d1d5db; font-size: 10px; color: #374151; overflow-wrap: anywhere; word-break: break-word; white-space: normal; page-break-inside: avoid; }
  .stats-line strong { color: #111827; }
  .age-band-line { margin-bottom: 10px; padding: 7px 9px; background: {{secondaryColor}}; border: 1px solid #d1d5db; font-size: 10px; color: #374151; overflow-wrap: anywhere; word-break: break-word; white-space: normal; page-break-inside: avoid; }

  table.students { width: 100%; border-collapse: collapse; table-layout: fixed; margin-top: 4px; }
  table.students th { background: #1f2937; color: #ffffff; padding: 6px 5px; font-size: 9px; font-weight: 700; text-align: center; text-transform: uppercase; letter-spacing: 0.3px; border: 1px solid #111827; overflow-wrap: anywhere; word-break: break-word; white-space: normal; }
  table.students td { padding: 5px; text-align: center; border: 1px solid #9ca3af; font-size: 9px; vertical-align: middle; overflow-wrap: anywhere; word-break: break-word; white-space: normal; }
  table.students tr:nth-child(even) { background: #f9fafb; }
  table.students tr { page-break-inside: avoid; }
  table.students .left { text-align: left; }
  table.students .name { font-weight: 600; }
  table.students thead { display: table-header-group; }
  .initials { display: inline-block; min-width: 22px; padding: 3px 0; border-radius: 11px; background: #e5e7eb; color: #374151; font-weight: 800; font-size: 9px; }

  .gender-male { color: #1d4ed8; font-weight: 700; }
  .gender-female { color: #be185d; font-weight: 700; }
  .status-active { color: #047857; font-weight: 700; }
  .status-inactive { color: #b91c1c; font-weight: 700; }

  .footer { margin-top: 14px; font-size: 9px; color: #374151; text-align: center; border-top: 1px solid #9ca3af; padding-top: 7px; overflow-wrap: anywhere; word-break: break-word; }
  .footer .meta { display: flex; justify-content: space-between; gap: 10px; }

  @media print {
    body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>
</head>
<body>

<div class="school-header">
  <h1>{{school.name}}</h1>
  {{#if school.address}}<p>{{school.address}}</p>{{/if}}
  {{#if school.contact}}<p>{{school.contact}}</p>{{/if}}
</div>

<div class="report-title">
  <h2>CLASS LIST - {{className}}</h2>
  <p>{{#if levelType}}{{levelType}}{{else}}Level N/A{{/if}} | Generated on {{generatedAt}}</p>
</div>

<table class="meta-grid">
  <tr>
    <td class="label">Current Term</td>
    <td class="value">{{#if currentTerm}}{{currentTerm}}{{else}}N/A{{/if}}</td>
    <td class="label">Academic Year</td>
    <td class="value">{{#if academicYear}}{{academicYear}}{{else}}N/A{{/if}}</td>
  </tr>
  <tr>
    <td class="label">Class</td>
    <td class="value">{{className}}</td>
    <td class="label">Level</td>
    <td class="value">{{#if levelType}}{{levelType}}{{else}}N/A{{/if}}</td>
  </tr>
  <tr>
    <td class="label">Class Teacher</td>
    <td class="value">{{#if classTeacher}}{{classTeacher}}{{else}}N/A{{/if}}</td>
    <td class="label">Generated</td>
    <td class="value">{{generatedAt}}</td>
  </tr>
</table>

<table class="summary-grid">
  <tr>
    <td class="total"><div class="card-value">{{summary.total}}</div><div class="card-label">Total Students</div></td>
    <td class="male"><div class="card-value">{{summary.male}}</div><div class="card-label">Male ({{summary.malePercent}}%)</div></td>
    <td class="female"><div class="card-value">{{summary.female}}</div><div class="card-label">Female ({{summary.femalePercent}}%)</div></td>
    <td class="other"><div class="card-value">{{summary.other}}</div><div class="card-label">Other / Unspecified ({{summary.otherPercent}}%)</div></td>
    {{#if summary.capacity}}<td class="capacity"><div class="card-value">{{summary.capacity}}</div><div class="card-label">Capacity</div></td>{{/if}}
    <td class="warning"><div class="card-value">{{summary.missingDob}}</div><div class="card-label">Missing DOB</div></td>
  </tr>
</table>

<div class="stats-line">
  <strong>Gender distribution:</strong> Male {{summary.male}} ({{summary.malePercent}}%) | Female {{summary.female}} ({{summary.femalePercent}}%) |
  Other / Unspecified {{summary.other}} ({{summary.otherPercent}}%) | <strong>M:F ratio:</strong> {{summary.maleRatio}}:{{summary.femaleRatio}}
  {{#if summary.capacity}} | <strong>Capacity:</strong> {{summary.capacity}}{{/if}}
</div>

<div class="age-band-line">
  <strong>Age bands:</strong>
  {{#each summary.ageBands}}
    {{label}}: {{total}} (M {{male}}, F {{female}}, O {{other}}){{#unless @last}} |{{/unless}}
  {{else}}
    No age band data available
  {{/each}}
</div>

<table class="students">
  <colgroup>
    <col style="width:3.5%" />
    <col style="width:4%" />
    <col style="width:11%" />
    <col style="width:11%" />
    <col style="width:16%" />
    <col style="width:9%" />
    <col style="width:11%" />
    <col style="width:5%" />
    <col style="width:10%" />
    <col style="width:7%" />
  </colgroup>
  <thead>
    <tr>
      <th>#</th>
      <th>Stu.</th>
      <th>Admission No</th>
      <th>Last Name</th>
      <th>First Name</th>
      <th>Full Name</th>
      <th>Gender</th>
      <th>Date of Birth</th>
      <th>Age</th>
      <th>Status</th>
    </tr>
  </thead>
  <tbody>
    {{#each students}}
    <tr>
      <td>{{add @index 1}}</td>
      <td><span class="initials">{{initials firstName lastName}}</span></td>
      <td>{{admNo}}</td>
      <td class="left">{{lastName}}</td>
      <td class="left">{{firstName}}</td>
      <td class="left name">{{name}}</td>
      <td class="gender-{{genderClass}}">{{genderLabel}}</td>
      <td>{{dob}}</td>
      <td>{{age}}</td>
      <td class="status-{{statusClass}}">{{status}}</td>
    </tr>
    {{/each}}
  </tbody>
</table>

<div class="footer">
  <div class="meta">
    <span>{{school.name}}</span>
    <span>Page <span class="pageNumber"></span> of <span class="totalPages"></span></span>
    <span>{{generatedAt}}</span>
  </div>
</div>

</body>
</html>
