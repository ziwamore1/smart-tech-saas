<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8" />
<title>Performance Profile - {{student.firstName}} {{student.lastName}}</title>
<style>
  @page { margin: 15mm 12mm; size: A4; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Segoe UI', Arial, Helvetica, sans-serif; font-size: 13px; color: #111827; line-height: 1.5; }

  .page-break { page-break-after: always; }

  .student-header { background: linear-gradient(135deg, {{primaryColor}}, {{primaryColor}}dd); color: white; border-radius: 8px; padding: 20px 24px; margin-bottom: 20px; }
  .student-header h1 { font-size: 24px; margin-bottom: 4px; }
  .student-header .meta { font-size: 13px; opacity: 0.95; }
  .student-header table { margin-top: 10px; }
  .student-header td { padding: 2px 16px 2px 0; font-size: 12px; opacity: 0.95; }
  .student-header td b { opacity: 1; }

  .metric-grid { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 20px; }
  .metric-card { flex: 1; min-width: 100px; background: {{secondaryColor}}; border-radius: 8px; padding: 12px 14px; text-align: center; border: 1.5px solid #9ca3af; }
  .metric-card .value { font-size: 22px; font-weight: 800; color: {{primaryColor}}; }
  .metric-card .label { font-size: 10px; color: #374151; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 2px; font-weight: 600; }
  .metric-card.highlight { background: {{primaryColor}}; color: white; }
  .metric-card.highlight .value { color: white; }
  .metric-card.highlight .label { color: #ffffff; }

  .section-title { font-size: 14px; font-weight: 800; color: {{primaryColor}}; margin: 18px 0 10px; padding-bottom: 6px; border-bottom: 2px solid {{primaryColor}}; }

  table.data-table { width: 100%; border-collapse: collapse; margin-bottom: 16px; }
  table.data-table th { background: #1f2937; color: #ffffff; padding: 7px 10px; font-size: 12px; font-weight: 700; text-align: center; text-transform: uppercase; letter-spacing: 0.3px; border: 1px solid #111827; }
  table.data-table td { padding: 6px 10px; text-align: center; border: 1px solid #9ca3af; border-bottom-width: 1.5px; font-size: 12px; }
  table.data-table tr:nth-child(even) { background: #f3f4f6; }

  .tag-list { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; }
  .tag { display: inline-block; padding: 4px 12px; border-radius: 12px; font-size: 11px; font-weight: 700; }
  .tag.strength { background: #d1fae5; color: #065f46; }
  .tag.weakness { background: #fee2e2; color: #991b1b; }
  .tag.recommendation { background: #dbeafe; color: #1e40af; }

  .trend-improving { color: #065f46; font-weight: 700; }
  .trend-declining { color: #b91c1c; font-weight: 700; }
  .trend-stable { color: #92400e; font-weight: 700; }

  .chart-container { text-align: center; margin: 16px 0; }

  @media print {
    body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .page-break { page-break-after: always; }
  }
</style>
</head>
<body>

<div class="student-header" style="background: linear-gradient(135deg, {{template.primaryColor}}, {{template.primaryColor}}dd);">
  <h1>{{student.firstName}} {{student.lastName}}</h1>
  <div class="meta">Performance Profile</div>
  <table>
    <tr>
      <td><b>Admission:</b> {{student.admissionNumber}}</td>
      <td><b>Class:</b> {{className}}</td>
      <td><b>Term:</b> {{termName}} {{academicYear}}</td>
    </tr>
  </table>
</div>

<div class="metric-grid">
  <div class="metric-card highlight">
    <div class="value">{{formatNumber overallAverage}}%</div>
    <div class="label">Overall Average</div>
  </div>
  <div class="metric-card">
    <div class="value">{{classRank}} / {{totalStudents}}</div>
    <div class="label">Class Rank</div>
  </div>
  <div class="metric-card">
    <div class="value">{{formatNumber gpa}}</div>
    <div class="label">GPA</div>
  </div>
  <div class="metric-card">
    <div class="value">{{formatNumber attendanceRate}}%</div>
    <div class="label">Attendance</div>
  </div>
</div>

{{#if subjectPerformance.length}}
<div class="section-title">Subject Performance</div>
<table class="data-table">
  <thead>
    <tr><th style="text-align:left;">Subject</th><th>Score</th><th>Grade</th><th>Points</th><th>Trend</th></tr>
  </thead>
  <tbody>
    {{#each subjectPerformance}}
    <tr>
      <td style="text-align:left; font-weight:600;">{{subject}}</td>
      <td><strong>{{score}}</strong></td>
      <td>{{grade}}</td>
      <td>{{points}}</td>
      <td class="trend-{{trend}}">{{trend}}</td>
    </tr>
    {{/each}}
  </tbody>
</table>
{{/if}}

{{#if strengths.length}}
<div class="section-title">Strengths</div>
<div class="tag-list">
  {{#each strengths}}
  <span class="tag strength">{{this}}</span>
  {{/each}}
</div>
{{/if}}

{{#if weaknesses.length}}
<div class="section-title">Areas for Improvement</div>
<div class="tag-list">
  {{#each weaknesses}}
  <span class="tag weakness">{{this}}</span>
  {{/each}}
</div>
{{/if}}

{{#if recommendations.length}}
<div class="section-title">Recommendations</div>
<div class="tag-list">
  {{#each recommendations}}
  <span class="tag recommendation">{{this}}</span>
  {{/each}}
</div>
{{/if}}

{{#if competencyScores.length}}
<div class="section-title">Competency Development</div>
<div class="chart-container">
  {{{chart_radar (json competencyLabels) (json competencyDatasets) width=380 height=380}}}
</div>
<table class="data-table">
  <thead>
    <tr><th style="text-align:left;">Learning Area</th><th>Score</th><th>Level</th></tr>
  </thead>
  <tbody>
    {{#each competencyScores}}
    <tr>
      <td style="text-align:left;">{{area}}</td>
      <td><strong>{{score}}</strong></td>
      <td>{{level}}</td>
    </tr>
    {{/each}}
  </tbody>
</table>
{{/if}}

{{#if behavioralNotes.length}}
<div class="section-title">Behavioral Notes</div>
<ul style="padding-left: 20px; margin-bottom: 16px;">
  {{#each behavioralNotes}}
  <li style="font-size: 12px; color: #1f2937; margin-bottom: 4px;">{{this}}</li>
  {{/each}}
</ul>
{{/if}}

</body>
</html>
