# Production Redis is a separate Railway service named smarttech-redis.
# Set this in Railway using a private/reference variable, not in source control.
# Both redis:// and rediss:// URLs are supported.
REDIS_URL=

# PostgreSQL remains the authoritative persistent database.
DATABASE_URL=postgresql://user:password@private-postgres-host:5432/school_saas
NODE_ENV=production
PORT=3001
