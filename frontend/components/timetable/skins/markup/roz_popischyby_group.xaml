<Page>
<Page.Resources>
	<Style x:Key="hyp" TargetType="Hyperlink">
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Trigger.Setters>
					<Setter Property="TextDecorations" Value="Underline"/>
					<Setter Property="Foreground" Value="#0928FF"/>
				</Trigger.Setters>
			</Trigger>
		</Style.Triggers>
		<Setter Property="Foreground" Value="#09286F"/>
		<Setter Property="TextDecorations" Value=""/>


	</Style>
	<Style x:Key="hyp2" TargetType="Hyperlink">
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Trigger.Setters>
					<Setter Property="Foreground" Value="#0928FF"/>
				</Trigger.Setters>
			</Trigger>
		</Style.Triggers>
		<Setter Property="TextDecorations" Value=""/>
	</Style>

	<LinearGradientBrush x:Key="FolderBrush" StartPoint="0, 0" EndPoint="1,0">
		<GradientStop Color="#c2ffc2" Offset="0"/>
		<GradientStop Color="#d3ffdf" Offset="0.5"/>
		<GradientStop Color="#c2ffc2" Offset="1"/>
	</LinearGradientBrush>
</Page.Resources>

