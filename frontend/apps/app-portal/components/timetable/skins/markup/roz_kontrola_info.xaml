<Page>
<Page.Resources>
	<Style x:Key="hyp" TargetType="Hyperlink">
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Trigger.Setters>
					<Setter Property="TextDecorations" Value="Underline"/>
					<Setter Property="Foreground" Value="#0928FF"/>
				</Trigger.Setters>
			</Trigger>
		</Style.Triggers>
		<Setter Property="Foreground" Value="#09286F"/>
		<Setter Property="TextDecorations" Value=""/>
		<Setter Property="TextDecorations" Value="Underline"/>

	</Style>
	<LinearGradientBrush x:Key="FolderBrush" StartPoint="0, 0" EndPoint="1,0">
		<GradientStop Color="#c2ffc2" Offset="0"/>
		<GradientStop Color="#d3ffdf" Offset="0.5"/>
		<GradientStop Color="#c2ffc2" Offset="1"/>
	</LinearGradientBrush>
</Page.Resources>

<Grid>
<Grid.ColumnDefinitions>
<ColumnDefinition MinWidth="50"/>
</Grid.ColumnDefinitions>
<Grid.RowDefinitions>
<RowDefinition Height='0'/>
<RowDefinition MinHeight="50"/>
<RowDefinition Height="0" MinHeight="0" />
</Grid.RowDefinitions>

<Border Grid.Row = "0" Grid.Column = "0" Padding='4' BorderThickness='0' BorderBrush='#767676' Background='#c2ffc2'>
<StackPanel >
<TextBlock HorizontalAlignment='Center' TextWrapping="Wrap">
{#1269}
</TextBlock>
</StackPanel>
</Border>

<Border Grid.Row = "1" Grid.Column = "0" Padding='4' BorderThickness='0' BorderBrush='#767676' Background='#c2ffc2'>
<StackPanel >
<TextBlock Foreground="#09286F" Padding='8, 6, 8, 13' HorizontalAlignment='Center' TextWrapping="Wrap">
{#1269}
</TextBlock>
<Image VerticalAlignment='Center' HorizontalAlignment='Center' Source='125'/>
<TextBlock Padding='8, 6, 8, 13' HorizontalAlignment='Right' VerticalAlignment='Bottom'>
<Hyperlink Style='{StaticResource hyp}' Tag='help_link'>{#3050}</Hyperlink></TextBlock>
</StackPanel>
</Border>


<Border Grid.Row = "2" Grid.Column = "0" Background="{StaticResource FolderBrush}">
<StackPanel>

<TextBlock Padding='8, 6, 8, 13' HorizontalAlignment='Right' VerticalAlignment='Center' FontSize="14">
<Hyperlink Style='{StaticResource hyp}' Tag='help_link' Cursor='Hand'><Image VerticalAlignment='Center' Source='120'/>{#3050}</Hyperlink></TextBlock>
</StackPanel>
</Border>
</Grid>
</Page>